DATABASE_URL="postgresql://erp:erp@localhost:5432/marketing_agency_erp"
AUTH_SECRET="replace-with-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# Local development preview only. Never enable in production.
ALLOW_DEV_SESSION="false"
DEV_SESSION_ROLE="ADMIN"

# Public demo only: password-less login buttons for seeded demo staff accounts.
# Anyone with the URL can enter the demo workspace. Never enable for real operations.
AUTH_DEMO_LOGIN="false"

# 절대 URL 생성용(결제 링크 등). 없으면 요청 헤더로 유추.
NEXT_PUBLIC_APP_URL=""

# --- 외부 연동 (env에 키를 넣으면 켜짐. 미설정 시 데모/미리보기로 동작) ---
# 워크플로우 7~11차. 연동 상태는 최고관리자 화면 /integrations 에서 확인.

# 네이버 검색광고 (검색량 조회). 미설정 시 데모 추정치.
NAVER_AD_API_KEY=""
NAVER_AD_SECRET=""
NAVER_AD_CUSTOMER_ID=""

# 이메일 발송 (보고서 메일, Resend). 미설정 시 발송 없이 미리보기.
EMAIL_API_KEY=""
EMAIL_FROM=""

# 카카오 알림톡 (보고서 알림). 미설정 시 발송 없이 미리보기.
# 발신프로필키와 대행사 엔드포인트가 필요.
KAKAO_ALIMTALK_API_KEY=""
KAKAO_ALIMTALK_SENDER=""
KAKAO_ALIMTALK_ENDPOINT=""

# 토스페이먼츠 (청구 결제 링크 /pay). 미설정 시 데모 결제.
# SECRET는 서버 승인용, CLIENT는 결제창(위젯)용.
TOSS_SECRET_KEY=""
TOSS_CLIENT_KEY=""

# --- 파일 저장 드라이버 (워크플로우 12차) ---
# db(기본) | blob | nas. 이관 시 이 값만 바꾸면 됨(코드 변경 없음).
STORAGE_DRIVER="db"
# blob 사용 시(Vercel Blob).
BLOB_READ_WRITE_TOKEN=""
# nas 사용 시(사내망 배포 후). 파일을 PUT/GET/DELETE 할 HTTP 엔드포인트와 인증 헤더.
NAS_ENDPOINT=""
NAS_AUTH=""

# Calendar integrations are connection-ready in V1.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
NAVER_CALENDAR_CLIENT_ID=""
NAVER_CALENDAR_CLIENT_SECRET=""

# Live PG is deferred. Provider fields are prepared for a later version.
TOSSPAYMENTS_SECRET_KEY=""
INICIS_MID=""
KAKAOPAY_ADMIN_KEY=""

# Bank/card transaction sync is deferred. FinancialAccount records are ready for provider mapping.
BANK_CARD_SYNC_PROVIDER=""
BANK_CARD_SYNC_CLIENT_ID=""
BANK_CARD_SYNC_CLIENT_SECRET=""
