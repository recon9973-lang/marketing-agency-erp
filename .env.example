DATABASE_URL="postgresql://erp:erp@localhost:5432/marketing_agency_erp"
AUTH_SECRET="replace-with-random-secret"
AUTH_URL="http://localhost:3000"

# Auth: 직원 전용 이메일 매직링크 로그인 (src/server/auth.ts). SMTP 설정 시 활성화.
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="no-reply@example.com"

# Legacy — Kakao OAuth is no longer wired (replaced by email magic-link). Kept for reference.
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# Local development preview only. Never enable in production.
ALLOW_DEV_SESSION="false"
DEV_SESSION_ROLE="ADMIN"

# Calendar integrations are connection-ready in V1.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
NAVER_CALENDAR_CLIENT_ID=""
NAVER_CALENDAR_CLIENT_SECRET=""

# Live PG is deferred. Provider fields are prepared for a later version.
TOSSPAYMENTS_SECRET_KEY=""
INICIS_MID=""
KAKAOPAY_ADMIN_KEY=""

# Bank/card transaction sync is deferred. FinancialAccount records are ready for provider mapping.
BANK_CARD_SYNC_PROVIDER=""
BANK_CARD_SYNC_CLIENT_ID=""
BANK_CARD_SYNC_CLIENT_SECRET=""

# V2.1 — channel account credential encryption (AES-256-GCM). 32 bytes: hex(64) or base64.
CREDENTIAL_ENC_KEY=""
# V2.1 — keyword rank proxy base URL (src/server/jobs/keyword-rank.ts).
KW_PROXY_URL=""
