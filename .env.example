# VENOM ERP — 환경변수 (실측 연동 키 전수 목록)
# ────────────────────────────────────────────────────────────
# 원칙: "키를 넣으면 켜진다". 키가 없으면 해당 기능은 데모/추정/미연결로 안전 강등되고,
#       /integrations 화면에 항목별 연결 상태(연결됨·미연결)가 실시간 표시된다.
#       ⚠️ 여기 적힌 변수명이 코드가 실제로 읽는 이름이다. 다른 이름으로 넣으면 미연결로 남는다.
#       배포(Vercel) 설정 후 /integrations 에서 최종 확인할 것.

# ═══ 1. 코어 (필수 — 없으면 앱 미동작) ═══
DATABASE_URL="postgresql://erp:erp@localhost:5432/marketing_agency_erp"  # Neon(pooled)
DATABASE_URL_UNPOOLED=""          # Neon(direct, 마이그레이션/db push)
AUTH_SECRET="replace-with-random-secret"   # openssl rand -base64 32
AUTH_URL="http://localhost:3000"  # 배포: https://erp.seokorea.org
CANONICAL_HOST=""                 # (선택) 정규 주소 통합 리다이렉트 대상
CREDENTIAL_ENC_KEY=""             # 거래처 자격증명 AES-256-GCM 키. openssl rand -hex 32. 변경 금지
# 부트스트랩 관리자 로그인 (이 이메일이 최고관리자로 자동 등록, 비번은 env로만 검증)
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="set-a-strong-password"
# 에셋 저장소(S3 호환) — 이미지·디자인 스튜디오·보관함 업로드. 미설정 시 DB(StoredFile) 폴백
STUDIO_S3_BUCKET=""
STUDIO_S3_ACCESS_KEY_ID=""
STUDIO_S3_SECRET_ACCESS_KEY=""
STUDIO_S3_REGION="auto"
STUDIO_S3_ENDPOINT=""             # R2/MinIO 등 커스텀 엔드포인트(선택)
STUDIO_S3_PUBLIC_BASE_URL=""      # 공개 CDN base(선택)
STUDIO_S3_FORCE_PATH_STYLE=""     # true|false

# ═══ 2. AI 생성·전사 ═══
ANTHROPIC_API_KEY=""              # Claude — 컨설팅·블로그·콘텐츠계획·매거진·GEO답변. 없으면 미리보기만
OPENAI_API_KEY=""                 # 이미지 생성 + Whisper 전사. 없으면 프롬프트복사/메모붙여넣기
OPENAI_IMAGE_MODEL=""             # (선택) 모델 오버라이드
OPENAI_TRANSCRIBE_MODEL=""        # (선택) 전사 모델 오버라이드
OPENAI_EMBED_MODEL=""             # (선택) 임베딩 모델(기본 text-embedding-3-small) — GEO CEP 의미 군집

# ═══ 3. 검색 데이터(네이버) — /keywords·/insights·/geo-cep ═══
# 네이버 검색 OpenAPI(지역검색·블로그·데이터랩) — 아래 CLIENT 또는 SEARCH_CLIENT 어느 쌍이든 인식(둘 다 넣어도 무해).
NAVER_CLIENT_ID=""                # 지역검색(경쟁사)·블로그(포화도)·데이터랩(트렌드). 없으면 데모/미표시
NAVER_CLIENT_SECRET=""
NAVER_SEARCH_CLIENT_ID=""         # 위와 동일한 검색 OpenAPI 자격증명의 대체 이름(월보장 트래커·guard-rank 크론에서도 사용)
NAVER_SEARCH_CLIENT_SECRET=""
NAVER_AD_API_KEY=""               # 검색광고(절대 월간 검색수 + 파워링크 CPC 실측). 없으면 CPC 미산출·검색량 데모
NAVER_AD_SECRET=""
NAVER_AD_CUSTOMER_ID=""
SGIS_CONSUMER_KEY=""              # 통계청 SGIS 오픈API(지역 인구·평균연령·세대수 실측). 없으면 인구축 미수집
SGIS_CONSUMER_SECRET=""           # SGIS 서비스 보안 Key
PUBLICDATA_SERVICE_KEY=""         # 공공데이터포털 일반 인증키(소상공인 상가정보 — 반경 상권 활성도). Decoding 키 권장. egress 차단 시 미표시
GEO_DATA_SOURCE=""                # (선택) mock | naver | hybrid(기본)

# ═══ 4. GEO 실측 4-AI 엔진(/geo 자동 관측) — 하나라도 있으면 켜짐, 없으면 수동 관측 ═══
# OPENAI_API_KEY 공용(위)
PERPLEXITY_API_KEY=""
GOOGLE_AI_API_KEY=""
OPENAI_MODEL=""                   # (선택) 모델 오버라이드
PERPLEXITY_MODEL=""
GEMINI_MODEL=""
GEO_ANTHROPIC_MODEL=""

# ═══ 5. 구글 GSC·GA4(검색·방문 실측) — 없으면 수기 입력 ═══
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ═══ 6. 메일(직원 매직링크·초대) — 없으면 관리자 비번 로그인 ═══
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="no-reply@venom.co.kr"

# ═══ 7. 메시지(카카오 알림톡) — 없으면 링크 복사 폴백 ═══
KAKAO_ALIMTALK_API_KEY=""
KAKAO_ALIMTALK_SENDER=""
KAKAO_ALIMTALK_ENDPOINT=""
KAKAO_ALIMTALK_TEMPLATE=""        # (선택) 승인 템플릿 코드

# ═══ 8. 제작·발행 — 없으면 초안 저장/수동 발행 ═══
WORDPRESS_SITE_URL=""
WORDPRESS_USER=""
WORDPRESS_APP_PASSWORD=""
MAKE_WEBHOOK_URL=""               # Make 멀티채널 발행 웹훅
SEO_GENERATOR_URL=""              # 외부 SEO 콘텐츠 생성기
HIGGSFIELD_API_URL=""
HIGGSFIELD_API_KEY=""
CANVA_ACCESS_TOKEN=""

# ═══ 9. 결제(토스페이먼츠) — 없으면 데모 결제 ═══
# ⚠️ 코드가 읽는 이름은 TOSS_SECRET_KEY (과거 TOSSPAYMENTS_SECRET_KEY 아님)
TOSS_SECRET_KEY=""
TOSS_CLIENT_KEY=""

# ═══ 10. 크론·운영 ═══
MARKETING_CRON_SECRET=""          # /api/marketing/cron 인증(일배치: guard-rank·알림·매거진·geo-watch)
CRON_SECRET=""                    # Vercel Cron(GET) 인증. 설정해야 일일 배치가 401 없이 실행
MAGAZINE_DAILY_DRAFTS=""          # (선택) 매거진 일일 초안 수
# ⚠️ 운영 전환 필수 — 공용 부트스트랩 관리자(admin@venom.app) 백도어 차단.
#    true로 두면 ADMIN_EMAIL/ADMIN_PASSWORD(또는 DB 해시)로만 로그인 가능.
DISABLE_BOOTSTRAP_ADMIN="false"   # 운영: true (그 전에 ADMIN_EMAIL/PASSWORD 먼저 설정)

# ═══ 11. 개발 전용(배포 미설정) ═══
ALLOW_DEV_SESSION="false"         # ?devRole= 역할 전환(로컬만). 프로덕션 금지
DEV_SESSION_ROLE="ADMIN"

# 참고:
# · 외부 캘린더(구글/네이버) 실시간 동기화는 코드 미구현 → 내부 캘린더 + .ics 내보내기 사용.
# · 과거 예시의 GOOGLE_CALENDAR_*·NAVER_CALENDAR_*·INICIS_MID·KAKAOPAY_ADMIN_KEY·
#   BANK_CARD_SYNC_*·KW_PROXY_URL 은 현행 코드가 읽지 않으므로 제거(넣어도 무동작).
