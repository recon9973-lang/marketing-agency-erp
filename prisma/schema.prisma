generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MARKETER
  CLIENT // 거래처 외부 사용자 (포털 전용)
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum WorkCategory {
  BRAND_BLOG
  BLOG_DISTRIBUTION
  BLOG_SEO
  RECEIPT_REVIEW
  PLACE_RANKING
  SNS_MANAGEMENT
  ACCOUNT_MANAGEMENT
  MONTHLY_REPORT
  PERFORMANCE_COLLECTION
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  REVIEW_NEEDED
  COMPLETED
  BLOCKED
}

enum BillingStatus {
  DRAFT
  ISSUED
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum ExpenseReviewStatus {
  UNREVIEWED
  REVIEWED
  EXCLUDED
  NEEDS_FOLLOW_UP
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELED
}

enum LeaveType {
  ANNUAL
  HALF_DAY_AM
  HALF_DAY_PM
  SICK
  OTHER
}

enum ReportStatus {
  DRAFT
  REVIEW_NEEDED
  APPROVED
  DELIVERED
}

enum CalendarProvider {
  INTERNAL
  GOOGLE
  NAVER
}

enum CalendarEventKind {
  TASK
  CLIENT_MEETING
  REPORT_DEADLINE
  LEAVE
  INTERNAL_INSTRUCTION
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  VIRTUAL_ACCOUNT
  OTHER
}

enum PaymentProvider {
  MANUAL
  KAKAOPAY
  TOSSPAYMENTS
  INICIS
  OTHER
}

enum FinancialAccountType {
  BANK
  CARD
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum ClientAccountPlatform {
  BLOG
  SNS
  PLACE
  RECEIPT_REVIEW
  ANALYTICS
  OTHER
}

// ─────────────────────────────────────────────
// 포털 전용 enum
// ─────────────────────────────────────────────

enum ClientStatus {
  PROSPECT      // 잠재 고객
  CONSULTING    // 상담 중
  MEETING       // 미팅 진행
  NEGOTIATING   // 계약 협의
  ACTIVE        // 계약 활성
  PAUSED        // 일시 중단
  LOST          // 이탈
}

enum ClientRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ClientRequestCategory {
  CONTENT_REQUEST
  REPORT_INQUIRY
  SCHEDULE_CHANGE
  ACCOUNT_ISSUE
  BILLING_INQUIRY
  OTHER
}

model User {
  id                      String          @id @default(cuid())
  name                    String
  email                   String          @unique
  emailVerified           DateTime?
  role                    Role
  status                  UserStatus      @default(ACTIVE)
  canAccessSettings       Boolean         @default(false)
  image                   String?
  kakaoId                 String?         @unique
  timezone                String          @default("Asia/Seoul")
  isActive                Boolean         @default(true)
  googleCalendarConnected Boolean         @default(false)
  naverCalendarConnected  Boolean         @default(false)
  // ─── 포털 사용자 전용 ───
  clientId                String?         // CLIENT 역할일 때 연결된 거래처
  portalNote              String?         // 관리자 메모 (포털 계정용)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  adminScopes             AccessScope[]   @relation("AdminScopes")
  scopedMarketers         AccessScope[]   @relation("ScopedMarketers")
  ownedClients            Client[]        @relation("AssignedMarketer")
  stageAssignedClients    Client[]        @relation("StageAssignee")
  managedAccounts         ClientAccount[] @relation("AccountManager")
  workTemplates           WorkTemplate[]  @relation("TemplateCreator")
  ownedWorkItems          WorkItem[]      @relation("WorkOwner")
  createdWorkItems        WorkItem[]      @relation("WorkCreator")
  createdEvents           CalendarEvent[] @relation("EventCreator")
  billingsIssued          BillingRecord[] @relation("BillingIssuer")
  paymentsRecorded        PaymentRecord[] @relation("PaymentRecorder")
  expensesSubmitted       ExpenseRecord[] @relation("ExpenseSubmitter")
  expensesReviewed        ExpenseRecord[] @relation("ExpenseReviewer")
  leavePolicies           LeavePolicy[]
  leaveRequests           LeaveRequest[]  @relation("LeaveRequester")
  leaveApprovals          LeaveRequest[]  @relation("LeaveApprover")
  authoredReports         Report[]        @relation("ReportAuthor")
  reviewedReports         Report[]        @relation("ReportReviewer")
  auditLogs               AuditLog[]      @relation("AuditActor")
  accounts                Account[]
  sessions                Session[]
  loginHistory            LoginHistory[]  @relation("UserLoginHistory")
  // ─── 포털 관계 ───
  portalClient            Client?         @relation("PortalUsers", fields: [clientId], references: [id])
  clientRequests          ClientRequest[] @relation("RequestAuthor")
  assignedRequests        ClientRequest[] @relation("RequestAssignee")
  clientComments          ClientComment[]
  clientAttachments       ClientAttachment[]

  @@index([clientId])
}

model AccessScope {
  id           String   @id @default(cuid())
  adminId      String
  marketerId   String?
  clientId     String?
  allMarketers Boolean  @default(false)
  allClients   Boolean  @default(false)
  createdAt    DateTime @default(now())

  admin    User    @relation("AdminScopes", fields: [adminId], references: [id])
  marketer User?   @relation("ScopedMarketers", fields: [marketerId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])

  @@index([adminId])
  @@index([marketerId])
  @@index([clientId])
}

model Client {
  id                 String            @id @default(cuid())
  name               String
  code               String            @unique
  businessNumber     String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  monthlyContractFee Decimal?          @db.Decimal(12, 2)
  serviceNotes       String?
  active             Boolean           @default(true)
  assignedMarketerId String?
  industryCategoryId String?
  industryCustom     String?
  // ─── 포털/영업 파이프라인 ───
  status             ClientStatus      @default(PROSPECT)
  statusHistory      Json?             // [{status, changedAt, changedBy, note}]
  stageAssigneeId    String?           // 현재 단계 담당자 (영업/마케터)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assignedMarketer   User?             @relation("AssignedMarketer", fields: [assignedMarketerId], references: [id])
  stageAssignee      User?             @relation("StageAssignee", fields: [stageAssigneeId], references: [id])
  industryCategory   IndustryCategory? @relation(fields: [industryCategoryId], references: [id])
  accessScopes       AccessScope[]
  accounts           ClientAccount[]
  workItems          WorkItem[]
  calendarEvents     CalendarEvent[]
  billingRecords     BillingRecord[]
  expenseRecords     ExpenseRecord[]
  reports            Report[]
  // ─── 포털 관계 ───
  portalUsers        User[]            @relation("PortalUsers")
  clientRequests     ClientRequest[]
  clientComments     ClientComment[]
  clientAttachments  ClientAttachment[]
  consultationForms  ConsultationForm[]

  @@index([assignedMarketerId])
  @@index([industryCategoryId])
  @@index([stageAssigneeId])
  @@index([status])
}

model ClientAccount {
  id             String                 @id @default(cuid())
  clientId       String
  managerId      String?
  platform       ClientAccountPlatform?
  channelTypeId  String?
  usernameEnc    String?
  passwordEnc    String?
  label          String
  handle         String?
  loginReference String?
  credentialHint String?
  externalUrl    String?
  isPrimary      Boolean                @default(false)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  client         Client                 @relation(fields: [clientId], references: [id])
  manager        User?                  @relation("AccountManager", fields: [managerId], references: [id])
  channelType    ChannelType?           @relation(fields: [channelTypeId], references: [id])

  @@index([clientId, platform])
  @@index([managerId])
  @@index([channelTypeId])
}

model WorkTemplate {
  id              String       @id @default(cuid())
  title           String
  description     String?
  category        WorkCategory
  defaultPriority Int          @default(3)
  estimatedHours  Decimal?     @db.Decimal(6, 2)
  cadenceDays     Int?
  active          Boolean      @default(true)
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       User?        @relation("TemplateCreator", fields: [createdById], references: [id])
  workItems       WorkItem[]

  @@index([category, active])
  @@index([createdById])
}

model WorkItem {
  id               String              @id @default(cuid())
  clientId         String
  ownerId          String
  createdById      String?
  templateId       String?
  title            String
  category         WorkCategory
  status           WorkStatus          @default(NOT_STARTED)
  priority         Int                 @default(3)
  dueDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  progressNotes    String?
  resultSummary    String?
  attachmentUrl    String?
  parentId         String?
  sequence         Int                 @default(0)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  estimatedMinutes Int?
  workCategoryId   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  client           Client              @relation(fields: [clientId], references: [id])
  owner            User                @relation("WorkOwner", fields: [ownerId], references: [id])
  createdBy        User?               @relation("WorkCreator", fields: [createdById], references: [id])
  template         WorkTemplate?       @relation(fields: [templateId], references: [id])
  parent           WorkItem?           @relation("WorkSubtasks", fields: [parentId], references: [id])
  subtasks         WorkItem[]          @relation("WorkSubtasks")
  workCategory     WorkCategoryMaster? @relation(fields: [workCategoryId], references: [id])
  calendarEvents   CalendarEvent[]
  reports          Report[]

  @@index([clientId, status, dueDate])
  @@index([ownerId, status, dueDate])
  @@index([templateId])
  @@index([createdById])
  @@index([parentId])
  @@index([ownerId, scheduledStart])
  @@index([workCategoryId])
}

model CalendarEvent {
  id                 String            @id @default(cuid())
  title              String
  description        String?
  startsAt           DateTime
  endsAt             DateTime
  provider           CalendarProvider  @default(INTERNAL)
  kind               CalendarEventKind
  syncStatus         ConnectionStatus  @default(DISCONNECTED)
  syncError          String?
  externalEventId    String?
  externalCalendarId String?
  lastSyncedAt       DateTime?
  clientId           String?
  workItemId         String?
  leaveRequestId     String?           @unique
  reportId           String?
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  client             Client?           @relation(fields: [clientId], references: [id])
  workItem           WorkItem?         @relation(fields: [workItemId], references: [id])
  leaveRequest       LeaveRequest?     @relation("LeaveRequestEvent", fields: [leaveRequestId], references: [id])
  report             Report?           @relation(fields: [reportId], references: [id])
  createdBy          User?             @relation("EventCreator", fields: [createdById], references: [id])

  @@index([startsAt, endsAt])
  @@index([clientId])
  @@index([workItemId])
  @@index([reportId])
  @@index([createdById])
}

model BillingRecord {
  id                   String            @id @default(cuid())
  clientId             String
  issuedById           String?
  billingMonth         DateTime
  contractAmount       Decimal           @db.Decimal(12, 2)
  issuedAmount         Decimal           @db.Decimal(12, 2)
  paidAmount           Decimal           @default(0) @db.Decimal(12, 2)
  currency             String            @default("KRW")
  status               BillingStatus     @default(DRAFT)
  invoiceNumber        String?           @unique
  dueDate              DateTime?
  issuedAt             DateTime?
  canceledAt           DateTime?
  pgProvider           PaymentProvider?
  pgCustomerReference  String?
  webhookStatus        String?
  reconciliationStatus String?
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  client               Client            @relation(fields: [clientId], references: [id])
  issuedBy             User?             @relation("BillingIssuer", fields: [issuedById], references: [id])
  payments             PaymentRecord[]
  bankMatches          BankTransaction[] @relation("BillingBankMatch")

  @@unique([clientId, billingMonth])
  @@index([status, dueDate])
  @@index([issuedById])
}

model PaymentRecord {
  id                   String          @id @default(cuid())
  billingRecordId      String
  recordedById         String?
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("KRW")
  method               PaymentMethod
  provider             PaymentProvider @default(MANUAL)
  transactionId        String?
  providerPaymentId    String?
  virtualAccountNumber String?
  webhookStatus        String?
  reconciliationStatus String?
  receivedAt           DateTime
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  billingRecord        BillingRecord   @relation(fields: [billingRecordId], references: [id])
  recordedBy           User?           @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([billingRecordId, receivedAt])
  @@index([recordedById])
}

model ExpenseRecord {
  id                    String              @id @default(cuid())
  clientId              String?
  submittedById         String?
  reviewedById          String?
  financialAccountId    String?
  category              String
  vendor                String?
  memo                  String?
  amount                Decimal             @db.Decimal(12, 2)
  taxAmount             Decimal?            @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  reviewStatus          ExpenseReviewStatus @default(UNREVIEWED)
  paidAt                DateTime?
  reviewedAt            DateTime?
  excludedReason        String?
  syncProvider          String?
  externalTransactionId String?
  externalReference     String?
  rawPayload            Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  client                Client?             @relation(fields: [clientId], references: [id])
  submittedBy           User?               @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  reviewedBy            User?               @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  financialAccount      FinancialAccount?   @relation(fields: [financialAccountId], references: [id])

  @@index([clientId])
  @@index([financialAccountId])
  @@index([reviewStatus, paidAt])
  @@index([submittedById])
  @@index([reviewedById])
}

model FinancialAccount {
  id                String               @id @default(cuid())
  type              FinancialAccountType
  displayName       String
  institutionName   String?
  accountLast4      String?
  cardLast4         String?
  currency          String               @default("KRW")
  isActive          Boolean              @default(true)
  connectionStatus  ConnectionStatus     @default(DISCONNECTED)
  provider          String?
  externalAccountId String?
  syncCursor        String?
  lastSyncedAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  expenseRecords    ExpenseRecord[]

  @@index([type, isActive])
}

model LeavePolicy {
  id            String         @id @default(cuid())
  userId        String
  year          Int
  annualDays    Decimal        @db.Decimal(5, 2)
  carryOverDays Decimal        @default(0) @db.Decimal(5, 2)
  usedDays      Decimal        @default(0) @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  leaveRequests LeaveRequest[]

  @@unique([userId, year])
  @@index([year])
}

model LeaveRequest {
  id            String         @id @default(cuid())
  requesterId   String
  approverId    String?
  leavePolicyId String?
  type          LeaveType
  status        LeaveStatus    @default(REQUESTED)
  startDate     DateTime
  endDate       DateTime
  daysRequested Decimal        @db.Decimal(5, 2)
  reason        String?
  reviewedAt    DateTime?
  canceledAt    DateTime?
  approvalNotes String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  requester     User           @relation("LeaveRequester", fields: [requesterId], references: [id])
  approver      User?          @relation("LeaveApprover", fields: [approverId], references: [id])
  leavePolicy   LeavePolicy?   @relation(fields: [leavePolicyId], references: [id])
  calendarEvent CalendarEvent? @relation("LeaveRequestEvent")

  @@index([requesterId, status, startDate])
  @@index([approverId])
  @@index([leavePolicyId])
}

model Report {
  id             String          @id @default(cuid())
  clientId       String
  authorId       String
  reviewerId     String?
  workItemId     String?
  reportingMonth DateTime
  title          String
  status         ReportStatus    @default(DRAFT)
  metrics        Json?
  notes          String?
  attachmentUrl  String?
  reviewedAt     DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  client         Client          @relation(fields: [clientId], references: [id])
  author         User            @relation("ReportAuthor", fields: [authorId], references: [id])
  reviewer       User?           @relation("ReportReviewer", fields: [reviewerId], references: [id])
  workItem       WorkItem?       @relation(fields: [workItemId], references: [id])
  calendarEvents CalendarEvent[]
  // ─── 포털 관계 ───
  comments       ClientComment[]
  attachments    ClientAttachment[]

  @@unique([clientId, reportingMonth])
  @@index([authorId])
  @@index([reviewerId])
  @@index([status])
  @@index([workItemId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  targetType  String
  targetId    String
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// V2.1 마스터/추적/재무/정책
// ─────────────────────────────────────────────

model IndustryCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  colorTag  String?
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   IndustryCategory?  @relation("IndustryTree", fields: [parentId], references: [id])
  children IndustryCategory[] @relation("IndustryTree")
  clients  Client[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model WorkCategoryMaster {
  id        String   @id @default(cuid())
  name      String
  group     String
  colorTag  String?
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItems WorkItem[]

  @@index([isActive, sortOrder])
}

model ChannelType {
  id        String   @id @default(cuid())
  name      String
  colorTag  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts ClientAccount[]

  @@index([isActive, sortOrder])
}

model LoginHistory {
  id        String    @id @default(cuid())
  userId    String
  at        DateTime  @default(now())
  ip        String?
  userAgent String?
  success   Boolean   @default(true)
  logoutAt  DateTime?

  user User @relation("UserLoginHistory", fields: [userId], references: [id])

  @@index([userId, at])
  @@index([at])
}

model BankTransaction {
  id               String   @id @default(cuid())
  importedAt       DateTime @default(now())
  txDate           DateTime
  amount           Decimal  @db.Decimal(14, 2)
  counterpartyName String?
  memo             String?
  matchStatus      String   @default("UNMATCHED")
  matchedBillingId String?

  matchedBilling BillingRecord? @relation("BillingBankMatch", fields: [matchedBillingId], references: [id])

  @@index([matchStatus, txDate])
  @@index([matchedBillingId])
}

model CompanySetting {
  id                    String   @id @default(cuid())
  adminCanManageExpense Boolean  @default(false)
  auditRetentionDays    Int      @default(365)
  workloadDailyMinutes  Int      @default(480)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ─────────────────────────────────────────────
// 클라이언트 포털 모델
// ─────────────────────────────────────────────

/// 거래처가 제출한 요청/문의
model ClientRequest {
  id          String               @id @default(cuid())
  clientId    String
  authorId    String
  assigneeId  String?              // 담당 마케터
  category    ClientRequestCategory
  title       String
  body        String
  status      ClientRequestStatus  @default(OPEN)
  adminNote   String?              // 마케터/관리자 공식 답변
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  client      Client               @relation(fields: [clientId], references: [id])
  author      User                 @relation("RequestAuthor", fields: [authorId], references: [id])
  assignee    User?                @relation("RequestAssignee", fields: [assigneeId], references: [id])
  comments    ClientComment[]
  attachments ClientAttachment[]

  @@index([clientId, status, createdAt])
  @@index([assigneeId, status])
  @@index([authorId])
}

/// 보고서 또는 요청에 달리는 댓글 (거래처/마케터 양방향)
model ClientComment {
  id        String   @id @default(cuid())
  authorId  String
  clientId  String   // 소속 거래처 (빠른 필터링용)
  body      String
  reportId  String?
  requestId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User           @relation(fields: [authorId], references: [id])
  client    Client         @relation(fields: [clientId], references: [id])
  report    Report?        @relation(fields: [reportId], references: [id])
  request   ClientRequest? @relation(fields: [requestId], references: [id])

  @@index([reportId, createdAt])
  @@index([requestId, createdAt])
  @@index([clientId, createdAt])
  @@index([authorId])
}

/// 포털에서 업로드된 첨부파일 메타데이터 (실제 파일은 Supabase Storage)
model ClientAttachment {
  id            String   @id @default(cuid())
  clientId      String
  uploaderId    String
  fileName      String
  fileUrl       String
  fileSizeBytes Int?
  mimeType      String?
  requestId     String?
  reportId      String?
  createdAt     DateTime @default(now())

  client    Client         @relation(fields: [clientId], references: [id])
  uploader  User           @relation(fields: [uploaderId], references: [id])
  request   ClientRequest? @relation(fields: [requestId], references: [id])
  report    Report?        @relation(fields: [reportId], references: [id])

  @@index([clientId, createdAt])
  @@index([requestId])
  @@index([reportId])
  @@index([uploaderId])
}

/// 상담 신청 폼 (영업 파이프라인 Stage 0)
model ConsultationForm {
  id          String   @id @default(cuid())
  clientId    String?  // 기존 거래처 연결 or null(신규 잠재 고객)
  companyName String
  contactName String
  contactPhone String?
  contactEmail String?
  serviceInterest String?
  budget       String?
  message      String?
  source       String?  // referral | direct | naver | instagram | etc.
  submittedAt  DateTime @default(now())
  reviewedAt   DateTime?
  reviewNote   String?

  client Client? @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([submittedAt])
}