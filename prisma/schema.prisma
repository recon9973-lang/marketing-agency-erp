generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 런타임/쿼리는 직접연결(DATABASE_URL_UNPOOLED) 사용 — Neon 풀러+Prisma prepared-statement
  // 이슈를 피한다. 이 프로젝트엔 DATABASE_URL_UNPOOLED 가 설정돼 있음.
  // 스키마 반영은 빌드의 `prisma db push`(전 배포를 깨뜨림)가 아니라,
  // 추가전용 마이그레이션(prisma/apply-manual-migrations.mjs)이 처리한다.
  url      = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MARKETER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum WorkCategory {
  BRAND_BLOG
  BLOG_DISTRIBUTION
  BLOG_SEO
  RECEIPT_REVIEW
  PLACE_RANKING
  SNS_MANAGEMENT
  ACCOUNT_MANAGEMENT
  MONTHLY_REPORT
  PERFORMANCE_COLLECTION
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  REVIEW_NEEDED
  COMPLETED
  BLOCKED
}

enum BillingStatus {
  DRAFT
  ISSUED
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum ExpenseReviewStatus {
  UNREVIEWED
  REVIEWED
  EXCLUDED
  NEEDS_FOLLOW_UP
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELED
}

enum LeaveType {
  ANNUAL
  HALF_DAY_AM
  HALF_DAY_PM
  SICK
  OTHER
}

enum ReportStatus {
  DRAFT
  REVIEW_NEEDED
  APPROVED
  DELIVERED
}

enum CalendarProvider {
  INTERNAL
  GOOGLE
  NAVER
}

// 거래처 상위 구분 — 병원 특화 기능(병원 프로파일·의료법 검수)의 적용 여부를 가른다.
// 세부 업종(진료과/기타)은 IndustryCategory가 담당하고, 이 플래그는 병원 버티컬 on/off용.
enum BusinessType {
  HOSPITAL
  OTHER
}

enum CalendarEventKind {
  TASK
  CLIENT_MEETING
  REPORT_DEADLINE
  LEAVE
  INTERNAL_INSTRUCTION
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  VIRTUAL_ACCOUNT
  OTHER
}

enum PaymentProvider {
  MANUAL
  KAKAOPAY
  TOSSPAYMENTS
  INICIS
  OTHER
}

enum FinancialAccountType {
  BANK
  CARD
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum ClientAccountPlatform {
  BLOG
  SNS
  PLACE
  RECEIPT_REVIEW
  ANALYTICS
  OTHER
}

model User {
  id                      String          @id @default(cuid())
  name                    String
  email                   String          @unique
  emailVerified           DateTime?
  role                    Role
  status                  UserStatus      @default(ACTIVE)
  canAccessSettings       Boolean         @default(false) // 최고관리자가 승인하면 관리자/담당자도 설정 화면 열람
  image                   String?
  kakaoId                 String?         @unique
  timezone                String          @default("Asia/Seoul")
  isActive                Boolean         @default(true)
  googleCalendarConnected Boolean         @default(false)
  naverCalendarConnected  Boolean         @default(false)
  orgId                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  organization            Organization?   @relation(fields: [orgId], references: [id])
  adminScopes             AccessScope[]   @relation("AdminScopes")
  scopedMarketers         AccessScope[]   @relation("ScopedMarketers")
  ownedClients            Client[]        @relation("AssignedMarketer")
  managedAccounts         ClientAccount[] @relation("AccountManager")
  workTemplates           WorkTemplate[]  @relation("TemplateCreator")
  ownedWorkItems          WorkItem[]      @relation("WorkOwner")
  createdWorkItems        WorkItem[]      @relation("WorkCreator")
  createdEvents           CalendarEvent[] @relation("EventCreator")
  billingsIssued          BillingRecord[] @relation("BillingIssuer")
  paymentsRecorded        PaymentRecord[] @relation("PaymentRecorder")
  expensesSubmitted       ExpenseRecord[] @relation("ExpenseSubmitter")
  expensesReviewed        ExpenseRecord[] @relation("ExpenseReviewer")
  leavePolicies           LeavePolicy[]
  leaveRequests           LeaveRequest[]  @relation("LeaveRequester")
  leaveApprovals          LeaveRequest[]  @relation("LeaveApprover")
  authoredReports         Report[]        @relation("ReportAuthor")
  reviewedReports         Report[]        @relation("ReportReviewer")
  auditLogs               AuditLog[]      @relation("AuditActor")
  accounts                Account[]
  sessions                Session[]
  loginHistory            LoginHistory[]  @relation("UserLoginHistory")
  authoredContracts       Contract[]      @relation("ContractAuthor")
  weeklyReports           WeeklyReport[]  @relation("WeeklyReportAuthor")
  vaultFolders            VaultFolder[]   @relation("VaultFolderCreator")
  uploadedFiles           StoredFile[]    @relation("FileUploader")
  aiContents              AiContent[]     @relation("AiContentAuthor")
  authoredComments        Comment[]       @relation("CommentAuthor")
  notifications           Notification[]  @relation("NotificationRecipient")
  actedNotifications      Notification[]  @relation("NotificationActor")
  timeLogs                TimeLog[]       @relation("TimeLogUser")
  authoredMeetings        Meeting[]       @relation("MeetingAuthor")
  meetingAttendances      MeetingAttendee[] @relation("MeetingAttendeeUser")
  chatMemberships   ChatMember[]
  chatMessages      ChatMessage[]
  chatRoomsCreated  ChatRoom[]        @relation("ChatRoomCreator")
  placeRankRecords  PlaceRankRecord[] @relation("PlaceRankRecorder")
  clientFavorites   ClientFavorite[]

  @@index([orgId])
}

model AccessScope {
  id           String   @id @default(cuid())
  adminId      String
  marketerId   String?
  clientId     String?
  allMarketers Boolean  @default(false)
  allClients   Boolean  @default(false)
  createdAt    DateTime @default(now())

  admin    User    @relation("AdminScopes", fields: [adminId], references: [id])
  marketer User?   @relation("ScopedMarketers", fields: [marketerId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])

  @@index([adminId])
  @@index([marketerId])
  @@index([clientId])
}

model Client {
  id                 String            @id @default(cuid())
  name               String
  code               String            @unique
  businessType       BusinessType      @default(HOSPITAL) // 병원 버티컬 on/off
  businessNumber     String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  monthlyContractFee Decimal?          @db.Decimal(12, 2)
  serviceNotes       String?
  active             Boolean           @default(true)
  assignedMarketerId String?
  industryCategoryId String?
  industryCustom     String? // 업종 "기타" 수기 입력
  orgId              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assignedMarketer   User?             @relation("AssignedMarketer", fields: [assignedMarketerId], references: [id])
  industryCategory   IndustryCategory? @relation(fields: [industryCategoryId], references: [id])
  organization       Organization?     @relation(fields: [orgId], references: [id])
  accessScopes       AccessScope[]
  accounts           ClientAccount[]
  workItems          WorkItem[]
  calendarEvents     CalendarEvent[]
  billingRecords     BillingRecord[]
  expenseRecords     ExpenseRecord[]
  reports            Report[]
  contracts          Contract[]
  aiContents         AiContent[]
  meetings           Meeting[]
  chatRooms         ChatRoom[]
  placeRankRecords  PlaceRankRecord[]
  favoredBy         ClientFavorite[]

  @@index([assignedMarketerId])
  @@index([industryCategoryId])
  @@index([orgId])
}

model ClientAccount {
  id             String                 @id @default(cuid())
  clientId       String
  managerId      String?
  platform       ClientAccountPlatform? // §3-D: 신규는 channelType 경로로 일원화, 이관 기간 nullable
  channelTypeId  String?
  usernameEnc    String? // AES-256-GCM 암호화 저장 (crypto.ts)
  passwordEnc    String? // AES-256-GCM 암호화 저장
  label          String
  handle         String?
  loginReference String?
  credentialHint String?
  externalUrl    String?
  isPrimary      Boolean                @default(false)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  client         Client                 @relation(fields: [clientId], references: [id])
  manager        User?                  @relation("AccountManager", fields: [managerId], references: [id])
  channelType    ChannelType?           @relation(fields: [channelTypeId], references: [id])

  @@index([clientId, platform])
  @@index([managerId])
  @@index([channelTypeId])
}

model WorkTemplate {
  id              String       @id @default(cuid())
  title           String
  description     String?
  category        WorkCategory
  defaultPriority Int          @default(3)
  estimatedHours  Decimal?     @db.Decimal(6, 2)
  cadenceDays     Int?
  active          Boolean      @default(true)
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       User?        @relation("TemplateCreator", fields: [createdById], references: [id])
  workItems       WorkItem[]

  @@index([category, active])
  @@index([createdById])
}

model WorkItem {
  id               String              @id @default(cuid())
  clientId         String
  ownerId          String
  createdById      String?
  templateId       String?
  title            String
  category         WorkCategory
  status           WorkStatus          @default(NOT_STARTED)
  priority         Int                 @default(3)
  dueDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  progressNotes    String?
  resultSummary    String?
  attachmentUrl    String?
  parentId         String?
  sequence         Int                 @default(0)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  estimatedMinutes Int?
  workCategoryId   String? // WorkCategoryMaster FK (기존 category enum과 병행/이관)
  orgId            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization?       @relation(fields: [orgId], references: [id])
  client           Client              @relation(fields: [clientId], references: [id])
  owner            User                @relation("WorkOwner", fields: [ownerId], references: [id])
  createdBy        User?               @relation("WorkCreator", fields: [createdById], references: [id])
  template         WorkTemplate?       @relation(fields: [templateId], references: [id])
  parent           WorkItem?           @relation("WorkSubtasks", fields: [parentId], references: [id])
  subtasks         WorkItem[]          @relation("WorkSubtasks")
  workCategory     WorkCategoryMaster? @relation(fields: [workCategoryId], references: [id])
  calendarEvents   CalendarEvent[]
  reports          Report[]
  timeLogs         TimeLog[]

  @@index([clientId, status, dueDate])
  @@index([ownerId, status, dueDate])
  @@index([templateId])
  @@index([createdById])
  @@index([parentId])
  @@index([ownerId, scheduledStart])
  @@index([workCategoryId])
  @@index([orgId])
}

model CalendarEvent {
  id                 String            @id @default(cuid())
  title              String
  description        String?
  startsAt           DateTime
  endsAt             DateTime
  provider           CalendarProvider  @default(INTERNAL)
  kind               CalendarEventKind
  syncStatus         ConnectionStatus  @default(DISCONNECTED)
  syncError          String?
  externalEventId    String?
  externalCalendarId String?
  lastSyncedAt       DateTime?
  clientId           String?
  workItemId         String?
  leaveRequestId     String?           @unique
  reportId           String?
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  client             Client?           @relation(fields: [clientId], references: [id])
  workItem           WorkItem?         @relation(fields: [workItemId], references: [id])
  leaveRequest       LeaveRequest?     @relation("LeaveRequestEvent", fields: [leaveRequestId], references: [id])
  report             Report?           @relation(fields: [reportId], references: [id])
  createdBy          User?             @relation("EventCreator", fields: [createdById], references: [id])

  @@index([startsAt, endsAt])
  @@index([clientId])
  @@index([workItemId])
  @@index([reportId])
  @@index([createdById])
}

model BillingRecord {
  id                   String            @id @default(cuid())
  clientId             String
  issuedById           String?
  billingMonth         DateTime
  contractAmount       Decimal           @db.Decimal(12, 2)
  issuedAmount         Decimal           @db.Decimal(12, 2)
  paidAmount           Decimal           @default(0) @db.Decimal(12, 2)
  currency             String            @default("KRW")
  status               BillingStatus     @default(DRAFT)
  invoiceNumber        String?           @unique
  dueDate              DateTime?
  issuedAt             DateTime?
  canceledAt           DateTime?
  pgProvider           PaymentProvider?
  pgCustomerReference  String?
  webhookStatus        String?
  reconciliationStatus String?
  metadata             Json?
  orgId                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organization         Organization?     @relation(fields: [orgId], references: [id])
  client               Client            @relation(fields: [clientId], references: [id])
  issuedBy             User?             @relation("BillingIssuer", fields: [issuedById], references: [id])
  payments             PaymentRecord[]
  bankMatches          BankTransaction[] @relation("BillingBankMatch")

  @@unique([clientId, billingMonth])
  @@index([status, dueDate])
  @@index([issuedById])
  @@index([orgId])
}

model PaymentRecord {
  id                   String          @id @default(cuid())
  billingRecordId      String
  recordedById         String?
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("KRW")
  method               PaymentMethod
  provider             PaymentProvider @default(MANUAL)
  transactionId        String?
  providerPaymentId    String?
  virtualAccountNumber String?
  webhookStatus        String?
  reconciliationStatus String?
  receivedAt           DateTime
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  billingRecord        BillingRecord   @relation(fields: [billingRecordId], references: [id])
  recordedBy           User?           @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([billingRecordId, receivedAt])
  @@index([recordedById])
}

model ExpenseRecord {
  id                    String              @id @default(cuid())
  clientId              String?
  submittedById         String?
  reviewedById          String?
  financialAccountId    String?
  category              String
  vendor                String?
  memo                  String?
  amount                Decimal             @db.Decimal(12, 2)
  taxAmount             Decimal?            @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  reviewStatus          ExpenseReviewStatus @default(UNREVIEWED)
  paidAt                DateTime?
  reviewedAt            DateTime?
  excludedReason        String?
  syncProvider          String?
  externalTransactionId String?
  externalReference     String?
  rawPayload            Json?
  orgId                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization?       @relation(fields: [orgId], references: [id])
  client                Client?             @relation(fields: [clientId], references: [id])
  submittedBy           User?               @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  reviewedBy            User?               @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  financialAccount      FinancialAccount?   @relation(fields: [financialAccountId], references: [id])

  @@index([clientId])
  @@index([financialAccountId])
  @@index([reviewStatus, paidAt])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([orgId])
}

model FinancialAccount {
  id                String               @id @default(cuid())
  type              FinancialAccountType
  displayName       String
  institutionName   String?
  accountLast4      String?
  cardLast4         String?
  currency          String               @default("KRW")
  isActive          Boolean              @default(true)
  connectionStatus  ConnectionStatus     @default(DISCONNECTED)
  provider          String?
  externalAccountId String?
  syncCursor        String?
  lastSyncedAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  expenseRecords    ExpenseRecord[]

  @@index([type, isActive])
}

model LeavePolicy {
  id            String         @id @default(cuid())
  userId        String
  year          Int
  annualDays    Decimal        @db.Decimal(5, 2)
  carryOverDays Decimal        @default(0) @db.Decimal(5, 2)
  usedDays      Decimal        @default(0) @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  leaveRequests LeaveRequest[]

  @@unique([userId, year])
  @@index([year])
}

model LeaveRequest {
  id            String         @id @default(cuid())
  requesterId   String
  approverId    String?
  leavePolicyId String?
  type          LeaveType
  status        LeaveStatus    @default(REQUESTED)
  startDate     DateTime
  endDate       DateTime
  daysRequested Decimal        @db.Decimal(5, 2)
  reason        String?
  reviewedAt    DateTime?
  canceledAt    DateTime?
  approvalNotes String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  requester     User           @relation("LeaveRequester", fields: [requesterId], references: [id])
  approver      User?          @relation("LeaveApprover", fields: [approverId], references: [id])
  leavePolicy   LeavePolicy?   @relation(fields: [leavePolicyId], references: [id])
  calendarEvent CalendarEvent? @relation("LeaveRequestEvent")

  @@index([requesterId, status, startDate])
  @@index([approverId])
  @@index([leavePolicyId])
}

model Report {
  id             String          @id @default(cuid())
  clientId       String
  authorId       String
  reviewerId     String?
  workItemId     String?
  reportingMonth DateTime
  title          String
  status         ReportStatus    @default(DRAFT)
  metrics        Json?
  notes          String?
  attachmentUrl  String?
  reviewedAt     DateTime?
  deliveredAt    DateTime?
  orgId          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization?   @relation(fields: [orgId], references: [id])
  client         Client          @relation(fields: [clientId], references: [id])
  author         User            @relation("ReportAuthor", fields: [authorId], references: [id])
  reviewer       User?           @relation("ReportReviewer", fields: [reviewerId], references: [id])
  workItem       WorkItem?       @relation(fields: [workItemId], references: [id])
  calendarEvents CalendarEvent[]

  @@unique([clientId, reportingMonth])
  @@index([authorId])
  @@index([reviewerId])
  @@index([status])
  @@index([workItemId])
  @@index([orgId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  targetType  String
  targetId    String
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// V2.1 마스터/추적/재무/정책 (erp-v2-staging 병합)
// ─────────────────────────────────────────────

/// 업종 마스터 (2단: parentId=null 대분류 / parent 지정 하위=진료과 등)
model IndustryCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  colorTag  String? // hex, 목록/캘린더 색상 표시
  isLocked  Boolean  @default(false) // 최고관리자만 해제/수정
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   IndustryCategory?  @relation("IndustryTree", fields: [parentId], references: [id])
  children IndustryCategory[] @relation("IndustryTree")
  clients  Client[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

/// 업무 카테고리 마스터 (그룹: 블로그/검색광고/지도/SNS/웹/운영)
model WorkCategoryMaster {
  id        String   @id @default(cuid())
  name      String
  group     String // 표시용 그룹 라벨
  colorTag  String?
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItems WorkItem[]

  @@index([isActive, sortOrder])
}

/// 채널 종류 마스터 (네이버블로그/인스타/플레이스/홈페이지/파워링크 등)
model ChannelType {
  id        String   @id @default(cuid())
  name      String
  colorTag  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts ClientAccount[]

  @@index([isActive, sortOrder])
}

/// 로그인 이력 (최고관리자 추적용)
model LoginHistory {
  id        String    @id @default(cuid())
  userId    String
  at        DateTime  @default(now())
  ip        String?
  userAgent String?
  success   Boolean   @default(true)
  logoutAt  DateTime?

  user User @relation("UserLoginHistory", fields: [userId], references: [id])

  @@index([userId, at])
  @@index([at])
}

/// 은행 거래내역 (입금 반자동 대사용 임포트 데이터)
model BankTransaction {
  id               String   @id @default(cuid())
  importedAt       DateTime @default(now())
  txDate           DateTime
  amount           Decimal  @db.Decimal(14, 2)
  counterpartyName String? // 입금자명
  memo             String?
  matchStatus      String   @default("UNMATCHED") // UNMATCHED/SUGGESTED/CONFIRMED/IGNORED
  matchedBillingId String?

  matchedBilling BillingRecord? @relation("BillingBankMatch", fields: [matchedBillingId], references: [id])

  @@index([matchStatus, txDate])
  @@index([matchedBillingId])
}

/// 조직(테넌트) — 멀티 회사·프로젝트 격리의 축. 현재는 기본 org 1건 운용(P1).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // 외부 노출용 안정 식별자
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  workItems      WorkItem[]
  billingRecords BillingRecord[]
  expenseRecords ExpenseRecord[]
  reports        Report[]
}

/// 회사 정책 (싱글턴 레코드로 운용)
model CompanySetting {
  id                    String   @id @default(cuid())
  adminCanManageExpense Boolean  @default(false) // 회사 지출 등록/검토를 관리자에게 허용할지
  auditRetentionDays    Int      @default(365) // 추적 로그 보존일
  workloadDailyMinutes  Int      @default(480) // 마케터 1일 가용시간(워크로드 기준)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// 계약서 — 거래처별 계약 문서. 태블릿에서 서명(사인)까지 처리.
/// signatureData 는 서명 이미지(PNG data URL, base64). status: DRAFT | SIGNED.
model Contract {
  id            String    @id @default(cuid())
  clientId      String
  authorId      String
  title         String
  body          String // 계약 내용(본문 텍스트)
  amount        Decimal?  @db.Decimal(12, 2) // 계약 금액(원)
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("DRAFT") // DRAFT | SIGNED
  signerName    String? // 서명자 이름(태블릿 입력)
  signerTitle   String? // 서명자 직함/소속
  signatureData String? // 서명 이미지 (PNG data URL)
  signedAt      DateTime?
  orgId         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id])
  author        User      @relation("ContractAuthor", fields: [authorId], references: [id])

  @@index([clientId])
  @@index([authorId])
  @@index([status])
  @@index([orgId])
}

/// 주간 업무보고 — 직원이 한 주 단위로 작성. weekStart = 해당 주 월요일.
/// status: DRAFT | SUBMITTED.
model WeeklyReport {
  id           String   @id @default(cuid())
  authorId     String
  weekStart    DateTime // 해당 주 시작일(월요일 00:00)
  summary      String // 한 줄 요약
  achievements String? // 이번 주 완료/성과
  plans        String? // 다음 주 계획
  issues       String? // 이슈/공유사항
  status       String   @default("SUBMITTED") // DRAFT | SUBMITTED
  orgId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation("WeeklyReportAuthor", fields: [authorId], references: [id])

  @@unique([authorId, weekStart])
  @@index([authorId])
  @@index([weekStart])
  @@index([orgId])
}

/// 보관함 폴더 — 최고관리자만 생성/삭제. 파일은 누구나 업로드/삭제.
model VaultFolder {
  id          String       @id @default(cuid())
  name        String
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User?        @relation("VaultFolderCreator", fields: [createdById], references: [id])
  files       StoredFile[]

  @@index([createdById])
}

/// 보관함 파일 — 바이트를 DB에 직접 저장(간단·이식성 우선).
model StoredFile {
  id           String       @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String?
  folderId     String?
  createdAt    DateTime     @default(now())
  uploadedBy   User?        @relation("FileUploader", fields: [uploadedById], references: [id])
  folder       VaultFolder? @relation(fields: [folderId], references: [id])
  chatMessages      ChatMessage[]

  @@index([uploadedById])
  @@index([folderId])
}

/// AI 마케팅 엔진 — Claude로 블로그/카드뉴스/SNS 문구를 생성해 보관.
/// kind: BLOG | CARD_NEWS | SNS | AD_COPY | KEYWORD. status: DONE | FAILED.
/// 결과(result)는 생성된 본문. keywords/topic 등 입력을 함께 저장해 재사용.
model AiContent {
  id        String   @id @default(cuid())
  authorId  String
  clientId  String? // 거래처 연계(선택)
  kind      String // BLOG | CARD_NEWS | SNS | AD_COPY | KEYWORD
  topic     String // 주제/제품/핵심 메시지
  keywords  String? // 강조 키워드(쉼표 구분)
  tone      String? // 톤앤매너(선택)
  result    String // 생성 결과 본문
  model     String? // 사용한 모델 ID
  status    String   @default("DONE") // DONE | FAILED
  orgId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("AiContentAuthor", fields: [authorId], references: [id])
  client    Client?  @relation(fields: [clientId], references: [id])

  @@index([authorId])
  @@index([clientId])
  @@index([kind])
  @@index([orgId])
}

/// 회의 — 녹음→STT(전사)→AI 회의록 정리. 참석자는 본인이 체크인.
/// transcript: 음성 전사 또는 붙여넣은 메모 원문. minutes: AI가 정리한 회의록(마크다운).
model Meeting {
  id          String            @id @default(cuid())
  title       String
  clientId    String?
  authorId    String
  meetingDate DateTime          @default(now())
  transcript  String? // 원문(STT 결과 또는 수기 메모)
  minutes     String? // AI 정리 회의록(마크다운)
  status      String            @default("DRAFT") // DRAFT | DONE
  orgId       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  author      User              @relation("MeetingAuthor", fields: [authorId], references: [id])
  client      Client?           @relation(fields: [clientId], references: [id])
  attendees   MeetingAttendee[]

  @@index([authorId])
  @@index([clientId])
  @@index([meetingDate])
  @@index([orgId])
}

/// 회의 참석자 — 본인이 클릭해 체크인. (meetingId, userId) 유일.
model MeetingAttendee {
  id          String   @id @default(cuid())
  meetingId   String
  userId      String
  checkedInAt DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User     @relation("MeetingAttendeeUser", fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([userId])
}

/// 업무 시간(공수) 기록 — 업무카드에 "언제 몇 분 작업했는지"를 남긴다.
/// 거래처별 투입시간·담당자 워크로드·수익성 계산의 기반 데이터.
model TimeLog {
  id         String   @id @default(cuid())
  workItemId String
  userId     String
  minutes    Int // 작업 시간(분)
  note       String?
  workedOn   DateTime // 작업한 날짜(집계 기준)
  orgId      String?
  createdAt  DateTime @default(now())
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user       User     @relation("TimeLogUser", fields: [userId], references: [id])

  @@index([workItemId])
  @@index([userId, workedOn])
  @@index([orgId])
}

/// 협업 댓글 — 여러 대상(거래처/업무/보고서/계약)에 스레드형으로 달린다.
/// targetType/targetId 조합으로 어디에 달린 댓글인지 구분. @멘션은 Notification 으로 이어진다.
model Comment {
  id         String   @id @default(cuid())
  authorId   String
  body       String
  targetType String // CLIENT | WORK | REPORT | CONTRACT
  targetId   String
  orgId      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([targetType, targetId])
  @@index([authorId])
  @@index([orgId])
}

/// 알림 — 수신자(userId)별로 쌓인다. 멘션/댓글/업무배정/마감 등.
/// link 를 클릭하면 해당 화면으로 이동. isRead 로 읽음 처리.
model Notification {
  id         String   @id @default(cuid())
  userId     String // 수신자
  actorId    String? // 행위자(누가 발생시켰나)
  type       String // MENTION | COMMENT | WORK_ASSIGNED | ...
  title      String
  body       String?
  link       String?
  targetType String?
  targetId   String?
  isRead     Boolean  @default(false)
  orgId      String?
  createdAt  DateTime @default(now())
  user       User     @relation("NotificationRecipient", fields: [userId], references: [id])
  actor      User?    @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ===== 통합 추가: 메시지(채팅)·플레이스순위·즐겨찾기 =====
enum ChatRoomType {
  DIRECT
  GROUP
}

model ChatRoom {
  id            String       @id @default(cuid())
  type          ChatRoomType @default(DIRECT)
  name          String?
  clientId      String?
  createdById   String?
  lastMessageAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  client        Client?      @relation(fields: [clientId], references: [id])
  createdBy     User?        @relation("ChatRoomCreator", fields: [createdById], references: [id])
  members       ChatMember[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
  @@index([clientId])
}

model ChatMember {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  room       ChatRoom  @relation(fields: [roomId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  roomId    String
  senderId  String
  body      String
  fileId    String?
  createdAt DateTime    @default(now())
  room      ChatRoom    @relation(fields: [roomId], references: [id])
  sender    User        @relation(fields: [senderId], references: [id])
  file      StoredFile? @relation(fields: [fileId], references: [id])

  @@index([roomId, createdAt])
  @@index([fileId])
}

model ClientFavorite {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])

  @@unique([userId, clientId])
  @@index([userId])
}

model PlaceRankRecord {
  id          String   @id @default(cuid())
  clientId    String
  keyword     String
  rank        Int
  recordedOn  DateTime @db.Date
  memo        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id])
  createdBy   User?    @relation("PlaceRankRecorder", fields: [createdById], references: [id])

  @@unique([clientId, keyword, recordedOn])
  @@index([clientId, recordedOn])
  @@index([createdById])
}
