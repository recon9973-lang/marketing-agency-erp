generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 런타임/쿼리는 직접연결(DATABASE_URL_UNPOOLED) 사용 — Neon 풀러+Prisma prepared-statement
  // 이슈를 피한다. 이 프로젝트엔 DATABASE_URL_UNPOOLED 가 설정돼 있음.
  // 스키마 반영은 빌드의 `prisma db push`(전 배포를 깨뜨림)가 아니라,
  // 추가전용 마이그레이션(prisma/apply-manual-migrations.mjs)이 처리한다.
  url      = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MARKETER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  PENDING // 셀프 가입 요청 — 관리자 승인 전까지 로그인 불가
}

enum WorkCategory {
  BRAND_BLOG
  BLOG_DISTRIBUTION
  BLOG_SEO
  RECEIPT_REVIEW
  PLACE_RANKING
  SNS_MANAGEMENT
  ACCOUNT_MANAGEMENT
  MONTHLY_REPORT
  PERFORMANCE_COLLECTION
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  REVIEW_NEEDED
  CLIENT_APPROVAL
  COMPLETED
  BLOCKED
}

enum BillingStatus {
  DRAFT
  ISSUED
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum ExpenseReviewStatus {
  UNREVIEWED
  REVIEWED
  EXCLUDED
  NEEDS_FOLLOW_UP
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELED
}

enum LeaveType {
  ANNUAL
  HALF_DAY_AM
  HALF_DAY_PM
  SICK
  OTHER
}

enum ReportStatus {
  DRAFT
  REVIEW_NEEDED
  APPROVED
  DELIVERED
}

enum CalendarProvider {
  INTERNAL
  GOOGLE
  NAVER
}

// 거래처 상위 구분 — 병원 특화 기능(병원 프로파일·의료법 검수)의 적용 여부를 가른다.
// 세부 업종(진료과/기타)은 IndustryCategory가 담당하고, 이 플래그는 병원 버티컬 on/off용.
enum BusinessType {
  HOSPITAL
  OTHER
}

// 서식(문서 템플릿) 사용처 카테고리 — 어느 화면에서 쓰이는지.
enum DocumentCategory {
  CONTRACT // 계약서
  CLIENT // 거래처(비밀유지 등)
  HR // 인사(근로계약·증명)
  GENERAL // 일반
}

enum CalendarEventKind {
  TASK
  CLIENT_MEETING
  REPORT_DEADLINE
  LEAVE
  INTERNAL_INSTRUCTION
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  VIRTUAL_ACCOUNT
  OTHER
}

enum PaymentProvider {
  MANUAL
  KAKAOPAY
  TOSSPAYMENTS
  INICIS
  OTHER
}

enum FinancialAccountType {
  BANK
  CARD
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum ClientAccountPlatform {
  BLOG
  SNS
  PLACE
  RECEIPT_REVIEW
  ANALYTICS
  OTHER
}

model User {
  id                      String          @id @default(cuid())
  name                    String
  email                   String          @unique
  emailVerified           DateTime?
  role                    Role
  status                  UserStatus      @default(ACTIVE)
  canAccessSettings       Boolean         @default(false) // 최고관리자가 승인하면 관리자/담당자도 설정 화면 열람
  image                   String?
  kakaoId                 String?         @unique
  loginLinkToken          String?         @unique // 이메일 없이 쓰는 개인 로그인 링크(초대/직원 접속). 재발급으로 폐기 가능.
  passwordHash            String?         // ERP 관리자 로그인 비밀번호(scrypt 해시). 설정 시 로그인에서 우선 검증, 미설정 시 env ADMIN_PASSWORD 사용.
  deniedFeatures          Json?           // 이 사용자에게 차단된 기능 키 목록(string[]). 예: ["finance","contracts"]. 비어있으면 전체 허용. 최고관리자는 무시.
  timezone                String          @default("Asia/Seoul")
  isActive                Boolean         @default(true)
  googleCalendarConnected Boolean         @default(false)
  naverCalendarConnected  Boolean         @default(false)
  orgId                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  organization            Organization?   @relation(fields: [orgId], references: [id])
  adminScopes             AccessScope[]   @relation("AdminScopes")
  scopedMarketers         AccessScope[]   @relation("ScopedMarketers")
  ownedClients            Client[]        @relation("AssignedMarketer")
  managedAccounts         ClientAccount[] @relation("AccountManager")
  workTemplates           WorkTemplate[]  @relation("TemplateCreator")
  ownedWorkItems          WorkItem[]      @relation("WorkOwner")
  createdWorkItems        WorkItem[]      @relation("WorkCreator")
  createdEvents           CalendarEvent[] @relation("EventCreator")
  assignedEvents          CalendarEvent[] @relation("EventAssignee")
  trendSnapshots          TrendSnapshot[] @relation("TrendSnapshotCapturer")
  geoCampaignPlans        GeoCampaignPlan[] @relation("GeoCampaignPlanAuthor")
  geoContentDiagnoses     GeoContentDiagnosis[] @relation("GeoContentDiagnosisAuthor")
  billingsIssued          BillingRecord[] @relation("BillingIssuer")
  paymentsRecorded        PaymentRecord[] @relation("PaymentRecorder")
  expensesSubmitted       ExpenseRecord[] @relation("ExpenseSubmitter")
  expensesReviewed        ExpenseRecord[] @relation("ExpenseReviewer")
  leavePolicies           LeavePolicy[]
  leaveRequests           LeaveRequest[]  @relation("LeaveRequester")
  leaveApprovals          LeaveRequest[]  @relation("LeaveApprover")
  authoredReports         Report[]        @relation("ReportAuthor")
  reviewedReports         Report[]        @relation("ReportReviewer")
  auditLogs               AuditLog[]      @relation("AuditActor")
  accounts                Account[]
  sessions                Session[]
  loginHistory            LoginHistory[]  @relation("UserLoginHistory")
  authoredContracts       Contract[]      @relation("ContractAuthor")
  consultingReports       ConsultingReport[] @relation("ConsultingAuthor")
  requestedApprovals      Approval[]      @relation("ApprovalRequester")
  decidedApprovals        Approval[]      @relation("ApprovalApprover")
  documentTemplates       DocumentTemplate[] @relation("DocTemplateAuthor")
  weeklyReports           WeeklyReport[]  @relation("WeeklyReportAuthor")
  vaultFolders            VaultFolder[]   @relation("VaultFolderCreator")
  uploadedFiles           StoredFile[]    @relation("FileUploader")
  aiContents              AiContent[]     @relation("AiContentAuthor")
  authoredComments        Comment[]       @relation("CommentAuthor")
  notifications           Notification[]  @relation("NotificationRecipient")
  actedNotifications      Notification[]  @relation("NotificationActor")
  timeLogs                TimeLog[]       @relation("TimeLogUser")
  authoredMeetings        Meeting[]       @relation("MeetingAuthor")
  meetingAttendances      MeetingAttendee[] @relation("MeetingAttendeeUser")
  chatMemberships   ChatMember[]
  chatMessages      ChatMessage[]
  chatRoomsCreated  ChatRoom[]        @relation("ChatRoomCreator")
  placeRankRecords  PlaceRankRecord[] @relation("PlaceRankRecorder")
  clientFavorites   ClientFavorite[]
  assignedLeads     Lead[]            @relation("LeadAssignee")
  geoQuestionApprovals GeoQuestion[]     @relation("GeoQuestionApprover")
  geoAnswerRecords     GeoAnswerRecord[] @relation("GeoAnswerRecorder")
  channelConnections   ChannelConnection[] @relation("ChannelConnector")

  @@index([orgId])
}

model AccessScope {
  id           String   @id @default(cuid())
  adminId      String
  marketerId   String?
  clientId     String?
  allMarketers Boolean  @default(false)
  allClients   Boolean  @default(false)
  createdAt    DateTime @default(now())

  admin    User    @relation("AdminScopes", fields: [adminId], references: [id])
  marketer User?   @relation("ScopedMarketers", fields: [marketerId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])

  @@index([adminId])
  @@index([marketerId])
  @@index([clientId])
}

model Client {
  id                 String            @id @default(cuid())
  name               String
  code               String            @unique
  businessType       BusinessType      @default(HOSPITAL) // 병원 버티컬 on/off
  portalToken        String?           @unique // 거래처 포털 공개 접근 토큰(로그인 불필요)
  businessNumber     String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  monthlyContractFee Decimal?          @db.Decimal(12, 2)
  region             String? // 지역(예: 서울 강남구) — GEO 질문 생성·로컬 채널에 자동 사용
  serviceNotes       String?
  active             Boolean           @default(true)
  // 라이프사이클 단계(계약 이후 5~8단계 백본). domain/sales/client-stages.ts의 유니온과 매핑.
  // ONBOARDING|KEYWORD|GEO|CONTENT|LIVE|PAUSED|CHURNED — Lead.status와 동일하게 String 관리.
  stage              String            @default("ONBOARDING")
  stageUpdatedAt     DateTime?
  assignedMarketerId String?
  industryCategoryId String?
  industryCustom     String? // 업종 "기타" 수기 입력
  orgId              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assignedMarketer   User?             @relation("AssignedMarketer", fields: [assignedMarketerId], references: [id])
  industryCategory   IndustryCategory? @relation(fields: [industryCategoryId], references: [id])
  organization       Organization?     @relation(fields: [orgId], references: [id])
  accessScopes       AccessScope[]
  accounts           ClientAccount[]
  workItems          WorkItem[]
  calendarEvents     CalendarEvent[]
  billingRecords     BillingRecord[]
  expenseRecords     ExpenseRecord[]
  reports            Report[]
  contracts          Contract[]
  aiContents         AiContent[]
  meetings           Meeting[]
  chatRooms         ChatRoom[]
  placeRankRecords  PlaceRankRecord[]
  favoredBy         ClientFavorite[]
  hospitalProfile   HospitalProfile?
  keywords          Keyword[]
  consultingReports ConsultingReport[]
  quotes            Quote[]
  surveys           Survey[]
  contentPlans      ContentPlan[]
  approvals         Approval[]
  clientFeedback    ClientFeedback[]
  channelMetrics    ChannelMetric[]
  leads             Lead[]
  geoQuestions      GeoQuestion[]
  geoInterventions  GeoIntervention[]
  channelConnections ChannelConnection[]

  @@index([assignedMarketerId])
  @@index([industryCategoryId])
  @@index([orgId])
  @@index([stage])
}

model ClientAccount {
  id             String                 @id @default(cuid())
  clientId       String
  managerId      String?
  platform       ClientAccountPlatform? // §3-D: 신규는 channelType 경로로 일원화, 이관 기간 nullable
  channelTypeId  String?
  usernameEnc    String? // AES-256-GCM 암호화 저장 (crypto.ts)
  passwordEnc    String? // AES-256-GCM 암호화 저장
  label          String
  handle         String?
  loginReference String?
  credentialHint String?
  externalUrl    String?
  isPrimary      Boolean                @default(false)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  client         Client                 @relation(fields: [clientId], references: [id])
  manager        User?                  @relation("AccountManager", fields: [managerId], references: [id])
  channelType    ChannelType?           @relation(fields: [channelTypeId], references: [id])

  @@index([clientId, platform])
  @@index([managerId])
  @@index([channelTypeId])
}

model WorkTemplate {
  id              String       @id @default(cuid())
  title           String
  description     String?
  category        WorkCategory
  defaultPriority Int          @default(3)
  estimatedHours  Decimal?     @db.Decimal(6, 2)
  cadenceDays     Int?
  active          Boolean      @default(true)
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       User?        @relation("TemplateCreator", fields: [createdById], references: [id])
  workItems       WorkItem[]

  @@index([category, active])
  @@index([createdById])
}

model WorkItem {
  id               String              @id @default(cuid())
  clientId         String
  ownerId          String
  createdById      String?
  templateId       String?
  title            String
  category         WorkCategory
  status           WorkStatus          @default(NOT_STARTED)
  priority         Int                 @default(3)
  dueDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  progressNotes    String?
  resultSummary    String?
  attachmentUrl    String?
  parentId         String?
  sequence         Int                 @default(0)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  estimatedMinutes Int?
  workCategoryId   String? // WorkCategoryMaster FK (기존 category enum과 병행/이관)
  orgId            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization?       @relation(fields: [orgId], references: [id])
  client           Client              @relation(fields: [clientId], references: [id])
  owner            User                @relation("WorkOwner", fields: [ownerId], references: [id])
  createdBy        User?               @relation("WorkCreator", fields: [createdById], references: [id])
  template         WorkTemplate?       @relation(fields: [templateId], references: [id])
  parent           WorkItem?           @relation("WorkSubtasks", fields: [parentId], references: [id])
  subtasks         WorkItem[]          @relation("WorkSubtasks")
  workCategory     WorkCategoryMaster? @relation(fields: [workCategoryId], references: [id])
  calendarEvents   CalendarEvent[]
  reports          Report[]
  timeLogs         TimeLog[]

  @@index([clientId, status, dueDate])
  @@index([ownerId, status, dueDate])
  @@index([templateId])
  @@index([createdById])
  @@index([parentId])
  @@index([ownerId, scheduledStart])
  @@index([workCategoryId])
  @@index([orgId])
}

model CalendarEvent {
  id                 String            @id @default(cuid())
  title              String
  description        String?
  startsAt           DateTime
  endsAt             DateTime
  provider           CalendarProvider  @default(INTERNAL)
  kind               CalendarEventKind
  syncStatus         ConnectionStatus  @default(DISCONNECTED)
  syncError          String?
  externalEventId    String?
  externalCalendarId String?
  lastSyncedAt       DateTime?
  clientId           String?
  workItemId         String?
  leaveRequestId     String?           @unique
  reportId           String?
  createdById        String?
  assigneeId         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  client             Client?           @relation(fields: [clientId], references: [id])
  workItem           WorkItem?         @relation(fields: [workItemId], references: [id])
  leaveRequest       LeaveRequest?     @relation("LeaveRequestEvent", fields: [leaveRequestId], references: [id])
  report             Report?           @relation(fields: [reportId], references: [id])
  createdBy          User?             @relation("EventCreator", fields: [createdById], references: [id])
  assignee           User?             @relation("EventAssignee", fields: [assigneeId], references: [id])

  @@index([startsAt, endsAt])
  @@index([clientId])
  @@index([workItemId])
  @@index([reportId])
  @@index([createdById])
  @@index([assigneeId])
}

// GEO Studio P3b — 브랜드 검색지수 시계열 스냅샷. 데이터랩은 6개월 롤링이라
// 저장해두지 않으면 과거 대비가 불가 → 조회 시점의 지수 이력을 남긴다(방향성 추적용).
model TrendSnapshot {
  id           String   @id @default(cuid())
  orgId        String?
  brand        String
  category     String
  keyword      String
  role         String // brand | category | competitor
  latestRatio  Float? // 조회 시점 최근 지수(0~100 상대)
  points       Json // {period,value}[] — 조회 시점 6개월 시계열
  capturedById String?
  capturedAt   DateTime @default(now())
  capturedBy   User?    @relation("TrendSnapshotCapturer", fields: [capturedById], references: [id])

  @@index([brand, category, capturedAt])
  @@index([orgId])
}

// GEO Studio M5 — 저장된 캠페인 계획(플래너 산출물 영속화). 추정 모델 산출이지만
// 마케터가 만든 계획을 보관·재열람하도록 저장(새로고침 소실 방지).
model GeoCampaignPlan {
  id          String   @id @default(cuid())
  orgId       String?
  name        String
  industry    String
  goalType    String
  budget      Int
  result      Json // GeoPlanResult
  report      String // 경영진 리포트(마크다운)
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("GeoCampaignPlanAuthor", fields: [createdById], references: [id])

  @@index([createdById, createdAt])
  @@index([orgId])
}

// GEO Studio M3 — 저장된 콘텐츠 GEO 진단(점수·재작성안 보관, 개선 추적용).
model GeoContentDiagnosis {
  id             String   @id @default(cuid())
  orgId          String?
  keyword        String
  contentPreview String // 진단 콘텐츠 앞부분(목록 라벨)
  scoreTotal     Int // GEO 종합 점수
  rewrite        String // BLUF 재작성안
  result         Json // ContentAnalysis 전체
  createdById    String?
  createdAt      DateTime @default(now())
  createdBy      User?    @relation("GeoContentDiagnosisAuthor", fields: [createdById], references: [id])

  @@index([createdById, createdAt])
  @@index([orgId])
}

model BillingRecord {
  id                   String            @id @default(cuid())
  clientId             String
  issuedById           String?
  billingMonth         DateTime
  contractAmount       Decimal           @db.Decimal(12, 2)
  issuedAmount         Decimal           @db.Decimal(12, 2)
  paidAmount           Decimal           @default(0) @db.Decimal(12, 2)
  currency             String            @default("KRW")
  status               BillingStatus     @default(DRAFT)
  invoiceNumber        String?           @unique
  dueDate              DateTime?
  issuedAt             DateTime?
  canceledAt           DateTime?
  pgProvider           PaymentProvider?
  pgCustomerReference  String?
  webhookStatus        String?
  reconciliationStatus String?
  metadata             Json?
  orgId                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organization         Organization?     @relation(fields: [orgId], references: [id])
  client               Client            @relation(fields: [clientId], references: [id])
  issuedBy             User?             @relation("BillingIssuer", fields: [issuedById], references: [id])
  payments             PaymentRecord[]
  bankMatches          BankTransaction[] @relation("BillingBankMatch")

  @@unique([clientId, billingMonth])
  @@index([status, dueDate])
  @@index([issuedById])
  @@index([orgId])
}

model PaymentRecord {
  id                   String          @id @default(cuid())
  billingRecordId      String
  recordedById         String?
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("KRW")
  method               PaymentMethod
  provider             PaymentProvider @default(MANUAL)
  transactionId        String?
  providerPaymentId    String?
  virtualAccountNumber String?
  webhookStatus        String?
  reconciliationStatus String?
  receivedAt           DateTime
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  billingRecord        BillingRecord   @relation(fields: [billingRecordId], references: [id])
  recordedBy           User?           @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([billingRecordId, receivedAt])
  @@index([recordedById])
}

model ExpenseRecord {
  id                    String              @id @default(cuid())
  clientId              String?
  submittedById         String?
  reviewedById          String?
  financialAccountId    String?
  category              String
  vendor                String?
  memo                  String?
  amount                Decimal             @db.Decimal(12, 2)
  taxAmount             Decimal?            @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  reviewStatus          ExpenseReviewStatus @default(UNREVIEWED)
  paidAt                DateTime?
  reviewedAt            DateTime?
  excludedReason        String?
  syncProvider          String?
  externalTransactionId String?
  externalReference     String?
  rawPayload            Json?
  orgId                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization?       @relation(fields: [orgId], references: [id])
  client                Client?             @relation(fields: [clientId], references: [id])
  submittedBy           User?               @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  reviewedBy            User?               @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  financialAccount      FinancialAccount?   @relation(fields: [financialAccountId], references: [id])

  @@index([clientId])
  @@index([financialAccountId])
  @@index([reviewStatus, paidAt])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([orgId])
}

model FinancialAccount {
  id                String               @id @default(cuid())
  type              FinancialAccountType
  displayName       String
  institutionName   String?
  accountLast4      String?
  cardLast4         String?
  currency          String               @default("KRW")
  isActive          Boolean              @default(true)
  connectionStatus  ConnectionStatus     @default(DISCONNECTED)
  provider          String?
  externalAccountId String?
  syncCursor        String?
  lastSyncedAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  expenseRecords    ExpenseRecord[]

  @@index([type, isActive])
}

model LeavePolicy {
  id            String         @id @default(cuid())
  userId        String
  year          Int
  annualDays    Decimal        @db.Decimal(5, 2)
  carryOverDays Decimal        @default(0) @db.Decimal(5, 2)
  usedDays      Decimal        @default(0) @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  leaveRequests LeaveRequest[]

  @@unique([userId, year])
  @@index([year])
}

model LeaveRequest {
  id            String         @id @default(cuid())
  requesterId   String
  approverId    String?
  leavePolicyId String?
  type          LeaveType
  status        LeaveStatus    @default(REQUESTED)
  startDate     DateTime
  endDate       DateTime
  daysRequested Decimal        @db.Decimal(5, 2)
  reason        String?
  reviewedAt    DateTime?
  canceledAt    DateTime?
  approvalNotes String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  requester     User           @relation("LeaveRequester", fields: [requesterId], references: [id])
  approver      User?          @relation("LeaveApprover", fields: [approverId], references: [id])
  leavePolicy   LeavePolicy?   @relation(fields: [leavePolicyId], references: [id])
  calendarEvent CalendarEvent? @relation("LeaveRequestEvent")

  @@index([requesterId, status, startDate])
  @@index([approverId])
  @@index([leavePolicyId])
}

model Report {
  id             String          @id @default(cuid())
  clientId       String
  authorId       String
  reviewerId     String?
  workItemId     String?
  reportingMonth DateTime
  title          String
  status         ReportStatus    @default(DRAFT)
  metrics        Json?
  notes          String?
  attachmentUrl  String?
  reviewedAt     DateTime?
  deliveredAt    DateTime?
  orgId          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization?   @relation(fields: [orgId], references: [id])
  client         Client          @relation(fields: [clientId], references: [id])
  author         User            @relation("ReportAuthor", fields: [authorId], references: [id])
  reviewer       User?           @relation("ReportReviewer", fields: [reviewerId], references: [id])
  workItem       WorkItem?       @relation(fields: [workItemId], references: [id])
  calendarEvents CalendarEvent[]

  @@unique([clientId, reportingMonth])
  @@index([authorId])
  @@index([reviewerId])
  @@index([status])
  @@index([workItemId])
  @@index([orgId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  targetType  String
  targetId    String
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// V2.1 마스터/추적/재무/정책 (erp-v2-staging 병합)
// ─────────────────────────────────────────────

/// 업종 마스터 (2단: parentId=null 대분류 / parent 지정 하위=진료과 등)
model IndustryCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  colorTag  String? // hex, 목록/캘린더 색상 표시
  isLocked  Boolean  @default(false) // 최고관리자만 해제/수정
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   IndustryCategory?  @relation("IndustryTree", fields: [parentId], references: [id])
  children IndustryCategory[] @relation("IndustryTree")
  clients  Client[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

/// 업무 카테고리 마스터 (그룹: 블로그/검색광고/지도/SNS/웹/운영)
model WorkCategoryMaster {
  id        String   @id @default(cuid())
  name      String
  group     String // 표시용 그룹 라벨
  colorTag  String?
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItems WorkItem[]

  @@index([isActive, sortOrder])
}

/// 채널 종류 마스터 (네이버블로그/인스타/플레이스/홈페이지/파워링크 등)
model ChannelType {
  id        String   @id @default(cuid())
  name      String
  colorTag  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts ClientAccount[]

  @@index([isActive, sortOrder])
}

/// 로그인 이력 (최고관리자 추적용)
model LoginHistory {
  id        String    @id @default(cuid())
  userId    String
  at        DateTime  @default(now())
  ip        String?
  userAgent String?
  success   Boolean   @default(true)
  logoutAt  DateTime?

  user User @relation("UserLoginHistory", fields: [userId], references: [id])

  @@index([userId, at])
  @@index([at])
}

/// 은행 거래내역 (입금 반자동 대사용 임포트 데이터)
model BankTransaction {
  id               String   @id @default(cuid())
  importedAt       DateTime @default(now())
  txDate           DateTime
  amount           Decimal  @db.Decimal(14, 2)
  counterpartyName String? // 입금자명
  memo             String?
  matchStatus      String   @default("UNMATCHED") // UNMATCHED/SUGGESTED/CONFIRMED/IGNORED
  matchedBillingId String?

  matchedBilling BillingRecord? @relation("BillingBankMatch", fields: [matchedBillingId], references: [id])

  @@index([matchStatus, txDate])
  @@index([matchedBillingId])
}

/// 조직(테넌트) — 멀티 회사·프로젝트 격리의 축. 현재는 기본 org 1건 운용(P1).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // 외부 노출용 안정 식별자
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  workItems      WorkItem[]
  billingRecords BillingRecord[]
  expenseRecords ExpenseRecord[]
  reports        Report[]
}

/// 회사 정책 (싱글턴 레코드로 운용)
model CompanySetting {
  id                    String   @id @default(cuid())
  adminCanManageExpense Boolean  @default(false) // 회사 지출 등록/검토를 관리자에게 허용할지
  auditRetentionDays    Int      @default(365) // 추적 로그 보존일
  workloadDailyMinutes  Int      @default(480) // 마케터 1일 가용시간(워크로드 기준)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// 계약서 — 거래처별 계약 문서. 태블릿에서 서명(사인)까지 처리.
/// signatureData 는 서명 이미지(PNG data URL, base64). status: DRAFT | SIGNED.
model Contract {
  id            String    @id @default(cuid())
  clientId      String
  authorId      String
  title         String
  body          String // 계약 내용(본문 텍스트, 레거시/폴백)
  details       Json? // 구조화 계약 항목(대행범위·갑정보·지불조건 등) — ContractDocument가 서식 렌더
  signToken     String?   @unique // 원격 서명 링크 토큰(/sign/{token})
  amount        Decimal?  @db.Decimal(12, 2) // 계약 금액(원)
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("DRAFT") // DRAFT | SIGNED
  signerName    String? // 서명자 이름(태블릿 입력)
  signerTitle   String? // 서명자 직함/소속
  signatureData String? // 서명 이미지 (PNG data URL)
  signedAt      DateTime?
  orgId         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client            @relation(fields: [clientId], references: [id])
  author        User              @relation("ContractAuthor", fields: [authorId], references: [id])
  products      ContractProduct[]
  surveys       Survey[]

  @@index([clientId])
  @@index([authorId])
  @@index([status])
  @@index([orgId])
}

/// 상품 마스터 — 대행 상품 정의. 계약에 붙이면 defaultTasks로 업무가 자동 생성될 기준.
/// defaultSurveyQuestions/defaultReportMetrics는 이후 설문·보고서 자동화에 사용.
model Product {
  id                     String            @id @default(cuid())
  name                   String
  category               String // 표시용 분류(블로그/플레이스/검색광고/웹 등)
  description            String?
  defaultTasks           Json? // 계약시 자동 생성할 업무 템플릿 목록
  defaultSurveyQuestions Json? // 상품별 설문 문항(Phase 3)
  defaultReportMetrics   Json? // 상품별 보고 지표(Phase 5)
  isActive               Boolean           @default(true)
  sortOrder              Int               @default(0)
  orgId                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  contractProducts       ContractProduct[]

  @@index([isActive, sortOrder])
  @@index([orgId])
}

/// 계약↔상품 브릿지 — "계약이 설문·콘텐츠·보고서로 자동 연결"되는 핵심(R1).
/// 계약에 담긴 상품별 월단가·광고비·수량.
model ContractProduct {
  id         String   @id @default(cuid())
  contractId String
  productId  String
  monthlyFee Decimal? @db.Decimal(12, 2) // 월 대행료
  adBudget   Decimal? @db.Decimal(12, 2) // 월 광고비(대행료와 구분)
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([contractId])
  @@index([productId])
}

/// 키워드 — 영업 컨설팅에서 산출. 채널(blog/place/powerlink/seo/geo/aeo)·우선순위·검색량.
model Keyword {
  id           String   @id @default(cuid())
  clientId     String
  keyword      String
  intent       String? // 검색 의도(정보/구매/비교 등)
  searchVolume Int? // 월 검색량(있을 때)
  trendRatio   Float? // 데이터랩 상대 트렌드(있을 때)
  priority     Int      @default(3) // 1(높음)~5(낮음)
  channel      String   @default("blog") // blog|place|powerlink|seo|geo|aeo
  // ── 월보장(순위 보장) — MarketerOps Phase 1 (모두 additive) ──
  isGuaranteed Boolean  @default(false) // 계약상 순위 보장 키워드
  targetRank   Int? // 보장 목표 순위(예: 상단통합 1위 → 1)
  guardChannel String   @default("blog") // 순위 측정 채널: blog|web|local (naverResearch.rankCheck)
  guardTarget  String? // 순위 판정 대상(블로그 URL·도메인·상호). 없으면 거래처 primary 계정에서 해석.
  orgId        String?
  createdAt    DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id])
  snapshots    ExposureSnapshot[]

  @@index([clientId, priority])
  @@index([clientId, isGuaranteed])
  @@index([orgId])
}

/// 노출 스냅샷 — 월보장 키워드의 채널별 순위 이력(전영역 검색 결과 적재).
/// rank=null → 미노출/조회실패(단정하지 않음). 하루 1회 upsert(멱등).
model ExposureSnapshot {
  id        String   @id @default(cuid())
  keywordId String
  channel   String // blog|web|local
  rank      Int? // API 결과 내 순번(실화면 순위 아님). null=미노출/조회실패
  checkedOn DateTime @db.Date
  source    String   @default("naver")
  orgId     String?
  createdAt DateTime @default(now())
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, channel, checkedOn])
  @@index([keywordId, checkedOn])
  @@index([orgId])
}

/// 컨설팅 리포트 — 신규 병원 영업 산출물. 병원명·주소 → 키워드·경쟁·상권 분석(AI).
model ConsultingReport {
  id             String   @id @default(cuid())
  // 계약 前(리드) 생성 가능 — clientId nullable, leadId로 리드에 붙었다가 전환 시 clientId로 승계.
  clientId       String?
  leadId         String?
  authorId       String
  hospitalName   String
  address        String?
  departments    String?
  keywords       Json? // 산출 키워드 요약
  competitors    Json? // 경쟁 병원 분석
  marketAnalysis String? // 상권 분석
  summary        String? // 요약
  status         String   @default("DRAFT") // DRAFT | SHARED
  orgId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client?  @relation(fields: [clientId], references: [id])
  lead           Lead?    @relation(fields: [leadId], references: [id])
  author         User     @relation("ConsultingAuthor", fields: [authorId], references: [id])

  @@index([clientId])
  @@index([leadId])
  @@index([authorId])
  @@index([orgId])
}

/// 견적서 — 가격대별 3종(BASIC/STANDARD/PREMIUM). 상품 마스터 기반 구성.
model Quote {
  id           String   @id @default(cuid())
  clientId     String? // 리드 단계 견적은 거래처 없이 발급(전환 시 링크) — 제안 전 게이트(워크플로우 02)
  leadId       String? // 제안발송 단계의 영업 리드 견적
  tier         String // BASIC | STANDARD | PREMIUM
  items        Json // [{productId?, name, monthlyFee, quantity}]
  monthlyTotal Decimal  @db.Decimal(12, 2)
  status       String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED
  note         String? // 미보장 고지 등 하단 문구(자동 삽입)
  validUntil   DateTime?
  orgId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client?  @relation(fields: [clientId], references: [id])
  lead         Lead?    @relation(fields: [leadId], references: [id])

  @@index([clientId, tier])
  @@index([leadId])
  @@index([orgId])
}

/// 거래처 피드백 — 포털에서 거래처가 남긴 의견(로그인 불필요). 담당자에게 알림.
model ClientFeedback {
  id        String   @id @default(cuid())
  clientId  String
  message   String
  kind      String   @default("GENERAL") // GENERAL | CONTENT_CONFIRM
  orgId     String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
}

/// 통합 승인 — 계약·견적·원고·콘텐츠·컴플라이언스 승인을 한 큐에서 관리.
/// targetType/targetId로 대상 참조, title은 표시용 비정규화.
model Approval {
  id          String    @id @default(cuid())
  targetType  String // CONTRACT | QUOTE | CONTENT | COMPLIANCE
  targetId    String
  title       String
  clientId    String?
  requesterId String
  approverId  String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  comment     String?
  orgId       String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  requester   User      @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approver    User?     @relation("ApprovalApprover", fields: [approverId], references: [id])
  client      Client?   @relation(fields: [clientId], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([requesterId])
  @@index([orgId])
}

/// 콘텐츠 기획안 — 월별·키워드별 주제 기획. AI 초안(방향·FAQ·Q&A) + 의료법 위험 표시.
/// status: PLANNED → DRAFTED → REVIEWED → APPROVED → PUBLISHED.
model ContentPlan {
  id             String   @id @default(cuid())
  clientId       String
  month          String // "YYYY-MM"
  keyword        String?
  topic          String
  angle           String? // 콘텐츠 방향
  faq             Json? // string[]
  qa              Json? // [{q, a}]
  draft           String? // 원고 초안(선택)
  complianceRisk  Json? // {high, medium, flags:[{label,matched,code,severity}]}
  status          String   @default("PLANNED")
  clientConfirmedAt DateTime? // 거래처 포털 컨펌 시각
  clientComment   String? // 거래처 컨펌 의견
  publishedUrl    String? // 게시 URL(§5-9 게시 증빙 — PUBLISHED 전이 시 기록)
  orgId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id])

  @@index([clientId, month])
  @@index([status])
  @@index([orgId])
}

/// GROUND 매거진 콘텐츠 트랙 — 병원 고객 콘텐츠(ContentPlan)와 분리.
/// 자사 미디어라 의료법·거래처 승인 게이트가 없고, 사람 검토 게이트만 유지.
/// 용어사전·아티클·사용법·동향을 큐로 관리 → AI 초안 → 검토 → 워드프레스 발행.
model MagazinePost {
  id           String   @id @default(cuid())
  title        String
  category     String // "AEO/GEO" | "SEO" | "AI마케팅" | "병원마케팅"
  kind         String   @default("glossary") // glossary | article | howto | news
  seed         String? // 한 줄 정의/메모(초안 생성 힌트)
  status       String    @default("QUEUED") // QUEUED → DRAFTED → REVIEWED → SCHEDULED → PUBLISHED
  draft        String? // 생성된 초안(마크다운/HTML)
  publishedUrl String? // 발행 URL(게시 증빙)
  wpPostId     Int? // 워드프레스 글 ID
  scheduledAt  DateTime? // 예약 발행 시각(있으면 워드프레스 future 예약)
  coverUrl     String? // 대표이미지 원본 URL(발행 증빙)
  orgId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([orgId])
}

/// 설문폼 — 계약 상품 기반 맞춤 설문. publicToken으로 외부(거래처)가 로그인 없이 응답.
model Survey {
  id          String           @id @default(cuid())
  clientId    String
  contractId  String?
  title       String
  questions   Json // [{id, label, type: text|textarea|choice, options?, required}]
  sentVia     String           @default("LINK") // LINK | KAKAO | SMS | EMAIL
  status      String           @default("DRAFT") // DRAFT | SENT | COMPLETED
  round       Int              @default(1) // 분기별 재설문 회차
  publicToken String           @unique
  orgId       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sentAt      DateTime?
  client      Client           @relation(fields: [clientId], references: [id])
  contract    Contract?        @relation(fields: [contractId], references: [id])
  responses   SurveyResponse[]

  @@index([clientId])
  @@index([contractId])
  @@index([orgId])
}

/// 설문 응답 — 외부(거래처)가 제출. 완료 시 콘텐츠 기획 태스크로 연결(Phase 4).
model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  answers     Json // {questionId: value}
  submittedAt DateTime @default(now())
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

/// 서식(문서 템플릿) — 계약서·비밀유지·근로계약 등. 관리자가 추가/수정/삭제.
/// category = 사용처(어느 화면에서 노출), minRole = 사용 가능 최소 권한.
/// body의 {중괄호}는 사용 시 채우는 자리표시자.
model DocumentTemplate {
  id          String           @id @default(cuid())
  name        String // 선택 라벨
  category    DocumentCategory
  title       String // 문서 제목 기본값
  body        String // 본문(자리표시자 포함)
  minRole     Role             @default(MARKETER) // 이 권한 이상만 사용/조회
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdById String?
  orgId       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User?            @relation("DocTemplateAuthor", fields: [createdById], references: [id])

  @@index([category, isActive, sortOrder])
  @@index([orgId])
}

/// 병원 프로파일 — 거래처별 단일 기준 데이터(Source of Truth).
/// 모든 AI 생성물·의료법 검수가 이 데이터를 참조한다. 변경 시 sotVersion 증가.
/// businessType = HOSPITAL 인 거래처만 사용.
model HospitalProfile {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  departments         String? // 진료과목(쉼표/줄바꿈 구분)
  doctors             String? // 대표원장·의료진 소개
  strengths           String? // 병원 강점
  cautionTerms        String? // 주의 표현
  preferredTone       String? // 선호 톤앤매너
  prohibitedClaims    String? // 금지 표현(의료법 검수 규칙엔진 주입)
  competitorHospitals String? // 경쟁 병원(쉼표/줄바꿈 구분)
  medicalLawNotes     String? // 의료법 주의사항 메모
  sotVersion          Int      @default(1) // 기준데이터 버전(변경 시 +1)
  orgId               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  client              Client   @relation(fields: [clientId], references: [id])

  @@index([orgId])
}

/// 주간 업무보고 — 직원이 한 주 단위로 작성. weekStart = 해당 주 월요일.
/// status: DRAFT | SUBMITTED.
model WeeklyReport {
  id           String   @id @default(cuid())
  authorId     String
  weekStart    DateTime // 해당 주 시작일(월요일 00:00)
  summary      String // 한 줄 요약
  achievements String? // 이번 주 완료/성과
  plans        String? // 다음 주 계획
  issues       String? // 이슈/공유사항
  status       String   @default("SUBMITTED") // DRAFT | SUBMITTED
  orgId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation("WeeklyReportAuthor", fields: [authorId], references: [id])

  @@unique([authorId, weekStart])
  @@index([authorId])
  @@index([weekStart])
  @@index([orgId])
}

/// 보관함 폴더 — 최고관리자만 생성/삭제. 파일은 누구나 업로드/삭제.
model VaultFolder {
  id          String       @id @default(cuid())
  name        String
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User?        @relation("VaultFolderCreator", fields: [createdById], references: [id])
  files       StoredFile[]

  @@index([createdById])
}

/// 보관함 파일 — 바이트를 DB에 직접 저장(간단·이식성 우선).
model StoredFile {
  id           String       @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String?
  folderId     String?
  createdAt    DateTime     @default(now())
  uploadedBy   User?        @relation("FileUploader", fields: [uploadedById], references: [id])
  folder       VaultFolder? @relation(fields: [folderId], references: [id])
  chatMessages      ChatMessage[]

  @@index([uploadedById])
  @@index([folderId])
}

/// AI 마케팅 엔진 — Claude로 블로그/카드뉴스/SNS 문구를 생성해 보관.
/// kind: BLOG | CARD_NEWS | SNS | AD_COPY | KEYWORD. status: DONE | FAILED.
/// 결과(result)는 생성된 본문. keywords/topic 등 입력을 함께 저장해 재사용.
model AiContent {
  id        String   @id @default(cuid())
  authorId  String
  clientId  String? // 거래처 연계(선택)
  kind      String // BLOG | CARD_NEWS | SNS | AD_COPY | KEYWORD
  topic     String // 주제/제품/핵심 메시지
  keywords  String? // 강조 키워드(쉼표 구분)
  tone      String? // 톤앤매너(선택)
  result    String // 생성 결과 본문
  model     String? // 사용한 모델 ID
  status    String   @default("DONE") // DONE | FAILED
  orgId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("AiContentAuthor", fields: [authorId], references: [id])
  client    Client?  @relation(fields: [clientId], references: [id])

  @@index([authorId])
  @@index([clientId])
  @@index([kind])
  @@index([orgId])
}

/// 회의 — 녹음→STT(전사)→AI 회의록 정리. 참석자는 본인이 체크인.
/// transcript: 음성 전사 또는 붙여넣은 메모 원문. minutes: AI가 정리한 회의록(마크다운).
model Meeting {
  id          String            @id @default(cuid())
  title       String
  clientId    String?
  authorId    String
  meetingDate DateTime          @default(now())
  transcript  String? // 원문(STT 결과 또는 수기 메모)
  minutes     String? // AI 정리 회의록(마크다운)
  status      String            @default("DRAFT") // DRAFT | DONE
  orgId       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  author      User              @relation("MeetingAuthor", fields: [authorId], references: [id])
  client      Client?           @relation(fields: [clientId], references: [id])
  attendees   MeetingAttendee[]

  @@index([authorId])
  @@index([clientId])
  @@index([meetingDate])
  @@index([orgId])
}

/// 회의 참석자 — 본인이 클릭해 체크인. (meetingId, userId) 유일.
model MeetingAttendee {
  id          String   @id @default(cuid())
  meetingId   String
  userId      String
  checkedInAt DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User     @relation("MeetingAttendeeUser", fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([userId])
}

/// 업무 시간(공수) 기록 — 업무카드에 "언제 몇 분 작업했는지"를 남긴다.
/// 거래처별 투입시간·담당자 워크로드·수익성 계산의 기반 데이터.
model TimeLog {
  id         String   @id @default(cuid())
  workItemId String
  userId     String
  minutes    Int // 작업 시간(분)
  note       String?
  workedOn   DateTime // 작업한 날짜(집계 기준)
  orgId      String?
  createdAt  DateTime @default(now())
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user       User     @relation("TimeLogUser", fields: [userId], references: [id])

  @@index([workItemId])
  @@index([userId, workedOn])
  @@index([orgId])
}

/// 협업 댓글 — 여러 대상(거래처/업무/보고서/계약)에 스레드형으로 달린다.
/// targetType/targetId 조합으로 어디에 달린 댓글인지 구분. @멘션은 Notification 으로 이어진다.
model Comment {
  id         String   @id @default(cuid())
  authorId   String
  body       String
  targetType String // CLIENT | WORK | REPORT | CONTRACT
  targetId   String
  orgId      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([targetType, targetId])
  @@index([authorId])
  @@index([orgId])
}

/// 알림 — 수신자(userId)별로 쌓인다. 멘션/댓글/업무배정/마감 등.
/// link 를 클릭하면 해당 화면으로 이동. isRead 로 읽음 처리.
model Notification {
  id         String   @id @default(cuid())
  userId     String // 수신자
  actorId    String? // 행위자(누가 발생시켰나)
  type       String // MENTION | COMMENT | WORK_ASSIGNED | ...
  title      String
  body       String?
  link       String?
  targetType String?
  targetId   String?
  isRead     Boolean  @default(false)
  orgId      String?
  createdAt  DateTime @default(now())
  user       User     @relation("NotificationRecipient", fields: [userId], references: [id])
  actor      User?    @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ===== 통합 추가: 메시지(채팅)·플레이스순위·즐겨찾기 =====
enum ChatRoomType {
  DIRECT
  GROUP
}

model ChatRoom {
  id            String       @id @default(cuid())
  type          ChatRoomType @default(DIRECT)
  name          String?
  clientId      String?
  createdById   String?
  lastMessageAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  client        Client?      @relation(fields: [clientId], references: [id])
  createdBy     User?        @relation("ChatRoomCreator", fields: [createdById], references: [id])
  members       ChatMember[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
  @@index([clientId])
}

model ChatMember {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  room       ChatRoom  @relation(fields: [roomId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  roomId    String
  senderId  String
  body      String
  fileId    String?
  createdAt DateTime    @default(now())
  room      ChatRoom    @relation(fields: [roomId], references: [id])
  sender    User        @relation(fields: [senderId], references: [id])
  file      StoredFile? @relation(fields: [fileId], references: [id])

  @@index([roomId, createdAt])
  @@index([fileId])
}

model ClientFavorite {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])

  @@unique([userId, clientId])
  @@index([userId])
}

model PlaceRankRecord {
  id          String   @id @default(cuid())
  clientId    String
  keyword     String
  rank        Int
  recordedOn  DateTime @db.Date
  memo        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id])
  createdBy   User?    @relation("PlaceRankRecorder", fields: [createdById], references: [id])

  @@unique([clientId, keyword, recordedOn])
  @@index([clientId, recordedOn])
  @@index([createdById])
}

/// 채널별 일일 지표 — 거래처 마케팅 인사이트용 방문자·노출 시계열.
/// channel: place|blog|homepage / metric: visitors|impressions. 값이 없으면 위젯은 수집 대기 상태로 표시.
model ChannelMetric {
  id         String   @id @default(cuid())
  clientId   String
  channel    String // place|blog|homepage
  metric     String // visitors|impressions
  recordedOn DateTime @db.Date
  value      Int      @default(0)
  orgId      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  client     Client   @relation(fields: [clientId], references: [id])

  @@unique([clientId, channel, metric, recordedOn])
  @@index([clientId, recordedOn])
  @@index([orgId])
}

/// 거래처 채널 API 연결 — GSC·GA4(구글 OAuth)·GBP 자격증명과 대상 리소스(§13 리포트 소스, §9 권한 회수).
/// refreshTokenEnc: AES-256-GCM 암호화 저장(crypto.ts). 회수(§14) = 레코드 상태 DISCONNECTED + 토큰 삭제.
model ChannelConnection {
  id              String    @id @default(cuid())
  clientId        String
  provider        String // GOOGLE (GSC+GA4 통합 동의) | GBP | NAVER_SA
  refreshTokenEnc String? // OAuth refresh token(암호화)
  gscSiteUrl      String? // 예: sc-domain:myclinic.co.kr 또는 https://myclinic.co.kr/
  ga4PropertyId   String? // 예: 123456789
  status          String    @default("DISCONNECTED") // DISCONNECTED | CONNECTED | ERROR
  lastSyncAt      DateTime?
  lastError       String?
  connectedById   String?
  orgId           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          Client    @relation(fields: [clientId], references: [id])
  connectedBy     User?     @relation("ChannelConnector", fields: [connectedById], references: [id])

  @@unique([clientId, provider])
  @@index([orgId])
}

/// 영업 리드 — 병원 SEO/GEO 영업 파이프라인(CRM). 계약 전 잠재고객 레코드.
/// status: NEW|CONTACTING|AUDIT|MEETING|PROPOSAL|WON|LOST|RECONTACT (전이 규칙은 domain/sales/lead-stages.ts)
/// 무료진단(§11 초기진단)은 별도 모델 대신 auditChecklist/auditScore/auditNote 3컬럼으로 리드에 내장.
/// consentAt/consentTextVersion: 개인정보 수집 동의 기록(개인정보보호법 §15 방어 — 어떤 고지문에 동의했는지 보존).
model Lead {
  id                 String    @id @default(cuid())
  hospitalName       String
  department         String? // 진료과
  region             String?
  source             String? // 유입 경로(폼/소개/리스트업로드 등)
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  websiteUrl         String?
  placeUrl           String?
  adBudgetEstimate   Decimal?  @db.Decimal(12, 2) // 월 광고비 추정
  note               String?
  status             String    @default("NEW")
  grade              String? // A|B|C 등급
  assigneeId         String? // 담당 AE
  nextActionAt       DateTime? // 다음 액션/재접촉 예정일
  consentAt          DateTime? // 개인정보 수집 동의 시각
  consentTextVersion String? // 동의 고지문 버전
  auditChecklist     Json? // 무료진단 체크리스트 {key: boolean} (§11 8항목, 수동 보조)
  auditScore         Int? // 진단 점수 0–100 (VENOM 엔진 종합점수, 없으면 수동 체크리스트 합산)
  auditNote          String? // 진단 메모/브리핑 포인트
  auditResult        Json? // VENOM 엔진 실측 진단 결과(카테고리·항목·등급 전체)
  auditEngineVersion String? // 진단에 사용된 엔진 버전(예: 1.7.0)
  auditRunAt         DateTime? // 엔진 진단 실행 시각
  lostReason         String?
  clientId           String? // WON → 거래처 전환 시 링크
  orgId              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  assignee           User?     @relation("LeadAssignee", fields: [assigneeId], references: [id])
  client             Client?   @relation(fields: [clientId], references: [id])
  quotes             Quote[]
  consultingReports  ConsultingReport[]

  @@index([status, nextActionAt])
  @@index([assigneeId])
  @@index([clientId])
  @@index([orgId])
}

/// GEO 질문 — 생성형 AI 답변 모니터링 대상 질문(진료과별 20개 세트).
/// status: CANDIDATE|APPROVED|MONITORING|RETIRED. 승인은 배치(일괄)로 하고 approvedBy/At에 기록.
/// AI 답변 노출은 "보장"이 아닌 모니터링 지표 — 화면·리포트에 미보장 고지 상시 표기.
model GeoQuestion {
  id            String    @id @default(cuid())
  clientId      String
  department    String?
  question      String
  qtype         String? // SOP 5유형: 정의형|판단형|비교형|위험형|지역형 (업무매뉴얼 05)
  priority      Int       @default(3) // 1(높음)~5(낮음)
  status        String    @default("CANDIDATE")
  approvedAt    DateTime?
  approvedById  String?
  targetPageUrl String? // 이 질문에 대응하는 병원 페이지(있으면)
  answerPlanId  String? // 자동 생성된 답변 페이지(ContentPlan) 링크 — 게시되면 targetPageUrl 자동 채움
  orgId         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id])
  approvedBy    User?     @relation("GeoQuestionApprover", fields: [approvedById], references: [id])
  answerRecords GeoAnswerRecord[]

  @@index([clientId, status])
  @@index([orgId])
}

/// GEO 답변 기록 — 질문×엔진×일자 단위의 AI 답변 출현 관측(수동 실행 기록).
/// 약관상 자동 스크래핑은 배제 — 담당자가 실행 결과를 기록하고 캡처 링크를 남긴다(상품 증빙).
model GeoAnswerRecord {
  id                   String      @id @default(cuid())
  questionId           String
  engine               String // CHATGPT|PERPLEXITY|GEMINI|CLAUDE|AI_OVERVIEW|NAVER_AI
  checkedOn            DateTime    @db.Date
  appeared             Boolean     @default(false) // 병원 언급 여부
  cited                Boolean     @default(false) // 공식 URL 인용 여부
  rank                 Int? // 답변 내 우리 병원 등장 순위(1=최상단, null=미언급/미측정) — 평균순위 집계용
  // ── GEO 논문 근거 측정층(모두 additive·nullable, 캡처는 점진 도입) ──
  // 근거: Xu/Venkit(충실성), What Gets Cited(위치), Citation Absorption(비중) — GEO 문헌 검토 2026-07
  claimSupported       Boolean? // 인용 페이지가 실제로 답변 문장을 뒷받침하는가(충실성). 의료 리스크 관리 핵심
  citationPosition     Int? // 답변 내 우리 인용 위치(1=최상단) — 인용 확률의 top driver
  answerShare          Float? // 답변 중 우리 정보 비중(0~1) — 인용 여부보다 흡수도가 실영향
  wrongClaim           Boolean  @default(false) // 엔진이 병원에 대해 틀린 정보를 말함(거버넌스·정직성)
  competitorsMentioned Json? // 언급된 경쟁사 이름 배열
  snippet              String? // 답변 발췌
  evidenceUrl          String? // 캡처/증빙 링크
  memo                 String?
  createdById          String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  question             GeoQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdBy            User?       @relation("GeoAnswerRecorder", fields: [createdById], references: [id])

  @@unique([questionId, engine, checkedOn])
  @@index([questionId, checkedOn])
  @@index([createdById])
}

/// GEO 언급률 시계열 스냅샷(GEO 모듈 설계 §2.2) — 관측 실행일(runAt)마다 거래처 전체 집계 저장.
/// 원천은 GeoAnswerRecord. 이 표는 일별 추이 그래프·월간 리포트·대시보드 조회 최적화용(캐시성).
/// questionId=null = 거래처 전체 집계. 재계산은 [clientId, questionId, runAt] 기준 멱등 upsert.
model GeoCitationScore {
  id              String   @id @default(cuid())
  clientId        String
  questionId      String? // null = 거래처 전체
  runAt           DateTime @db.Date // 관측 실행일(일별 그래놀)
  totalModels     Int // 관측 대상 엔진 수(분모)
  mentionedModels Int // 언급된 엔진 수(분자)
  mentionRate     Float // mentioned/total (0~1)
  avgRank         Float? // 언급 시 평균 등장 순위
  citedModels     Int      @default(0) // 공식 URL 인용 엔진 수
  byEngine        Json? // {engine:{mentioned,cited,rank}} — 레이더·엔진표용
  orgId           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, questionId, runAt])
  @@index([clientId, runAt])
}

// GEO 학습 모델 버전 — 쌓인 실험 장부(개입→인용률)를 학습해 전략 가중치를 산출.
// 버전 넘버링(org 단위 1,2,3…), 공지로 제안→적용, 넘버/기간별 다운그레이드(롤백).
// 학습 원칙: 정답 신호는 실측(GeoCitationScore/GeoIntervention.lift)만. 투명 가중치(설명가능).
model GeoModelVersion {
  id           String    @id @default(cuid())
  version      Int // org 단위 순번(1,2,3…)
  orgId        String?
  status       String    @default("PROPOSED") // PROPOSED | ACTIVE | SUPERSEDED | ROLLED_BACK
  summary      String // 무엇이 바뀌었나(한 줄)
  weights      Json // 학습된 전략 가중치({kind:{avgLift,upRate,weight}} 등)
  diff         Json? // 직전 활성 버전 대비 변경점(가중치 증감)
  basisCount   Int       @default(0) // 학습에 쓰인 결과측정 개입 수(표본)
  noticeId     String? // 연결된 공지 id(제안 게시)
  proposedById String?
  appliedById  String?
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([orgId, version])
  @@index([status])
  @@index([orgId, createdAt])
}

// GEO 실험 장부(학습 A단계) — "개입 → 인용률 변화"를 근거로 기록.
// 개입 시점의 인용률(baselineRate)을 스냅샷하고, 이후 측정치로 상승폭(lift)을 계산한다.
// 학습의 정답 신호는 반드시 실측(GeoCitationScore.mentionRate)에만 붙인다(목업 아님).
model GeoIntervention {
  id           String    @id @default(cuid())
  clientId     String
  kind         String // CONTENT_PUBLISH | CONTENT_REWRITE | KEYWORD_ADD | GEO_QUESTION | MANUAL
  title        String // 무엇을 했나(예: "발행: 강남 임플란트 후기")
  detail       String? // 메모·상세
  refType      String? // 연결 엔티티 유형(ContentPlan/Keyword 등, 선택)
  refId        String? // 연결 엔티티 id(선택)
  occurredAt   DateTime // 개입 발생 시각
  baselineRate Float? // 개입 직전 최근 인용률(0~1, 기록 시 스냅샷)
  createdById  String?
  orgId        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt])
  @@index([orgId])
}

/// 디자인 스튜디오 프로젝트 — 카드뉴스/SNS/썸네일 등 캔버스 디자인.
/// 캔버스 문서(페이지·요소)는 해상도 독립 JSON(`data`)으로 저장한다.
/// MVP는 Neon Postgres만으로 동작(에셋 data URL 인라인). 대용량 에셋의 S3 이전은 후속.
model StudioProject {
  id        String   @id @default(cuid())
  orgId     String
  ownerId   String
  clientId  String? // (차별화) ERP 거래처 연동 여지
  title     String   @default("제목 없는 디자인")
  kind      String   @default("blank") // cardnews|sns|thumbnail|popup|banner|detail|blank
  canvasW   Int
  canvasH   Int
  data      Json // { version, pages:[{ id,width,height,background,elements:[...] }] }
  thumbnail String? // 대표 썸네일(data URL, 선택)
  status    String   @default("DRAFT") // DRAFT|ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, updatedAt])
  @@index([ownerId])
  @@index([clientId])
}

/// 브랜드킷 — 조직/거래처별 로고·컬러·폰트. 디자인 스튜디오에서 원클릭 적용(ERP 연동 차별화).
model BrandKit {
  id         String   @id @default(cuid())
  orgId      String
  clientId   String? // 거래처별 브랜드킷(선택)
  name       String
  colors     Json     @default("[]") // ["#d9662e", ...]
  logos      Json     @default("[]") // [{ url, variant }]
  fontFamily String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
  @@index([clientId])
}

/// 디자인 스튜디오 업로드 에셋 — 이미지 픽셀을 프로젝트 JSON 밖으로 분리한다.
/// 백엔드는 S3(설정 시) 또는 기존 StoredFile(DB BYTEA) 폴백. 에디터는 백엔드와
/// 무관하게 안정적인 서빙 URL(/api/studio/assets/{id})만 참조한다.
model UploadedAsset {
  id         String   @id @default(cuid())
  orgId      String
  ownerId    String
  backend    String // "s3" | "db"
  storageKey String // S3 object key 또는 StoredFile id
  mimeType   String
  width      Int?
  height     Int?
  size       Int
  kind       String   @default("image") // image | logo | icon
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([ownerId])
}
